---
import Lab from "../../layouts/Lab.astro";
import Header from "../../components/lab/Header.astro";
import Icon from "../../components/lab/Icon.astro";
import Desktop from "../../components/lab/Desktop.astro";
import Phone from "../../components/lab/Phone.astro";
import Scenarios from "../../components/lab/Scenarios.astro";
import Bird from "../../components/Bird.astro";

const prompts = [
  [
    "Ping me if the nightly backup fails",
    "Ask before you spend more than $20 on ads",
    "Send me the weekly SEO report every Monday",
    "Ask me which of these three headlines to use",
    "Keep the training run's loss pinned at the top",
    "Ask me for the OpenAI key when you need it",
    "Tell me when the deploy is live",
  ],
  [
    "Show me the screenshots before you post them",
    "If a test keeps failing, ask me what to do",
    "Make me a panel with a button to restart the worker",
    "Send me the CSV when the crawl is done",
    "Check rply for new tasks when you're idle",
    "Ask me before you delete anything",
    "Post a summary when the PR is merged",
  ],
];

const runsOn = ["Claude Code", "Codex", "Cursor", "Gemini CLI", "OpenClaw", "cron", "GitHub Actions", "git hooks"];

const faqs = [
  {
    q: "Is this a remote control for Claude Code?",
    a: "No. rply doesn't mirror sessions or run your agent. Your agent decides when to reach you, and you answer.",
  },
  {
    q: "Do I need MCP?",
    a: "No. It's a CLI, so any agent with a shell can use it, and so can cron jobs and CI.",
  },
  {
    q: "How does my agent know how to use it?",
    a: "It runs rply guide once and learns the commands. After that you ask in plain words, like you would a colleague.",
  },
  {
    q: "Can the server read my messages?",
    a: "If you self-host, it's your server. Secrets are always encrypted on your device, so the server never sees them.",
  },
];
---

<Lab title="rply · direction A3">
  <Header />

  <section class="mx-auto max-w-6xl px-6 pt-20">
    <h1 class="max-w-3xl text-[clamp(2.75rem,6vw,4.5rem)] leading-[1] font-[550] tracking-[-0.04em]">
      Your agents can reach you now
    </h1>
    <div class="mt-6 flex flex-wrap items-end justify-between gap-8">
      <p class="max-w-xl text-lg leading-relaxed text-gray-500">
        Tell your agent to keep you posted, ask before it ships, or come to you when it needs a key. You answer from
        your phone or your laptop, and it carries on.
      </p>
      <div class="flex gap-3">
        <a href="/docs/start/quickstart/" class="btn btn-primary">Get started</a>
        <button class="btn btn-outline font-mono font-normal text-gray-600" data-copy="npx @rply/cli init https://rply.sh">
          <span class="text-gray-400">$</span> npx @rply/cli init
          <Icon name="copy" class="size-3.5 text-gray-400" />
        </button>
      </div>
    </div>

    <div class="stage relative mt-14 h-[680px] overflow-hidden rounded-3xl bg-linear-to-b from-gray-100 to-[#eceefb]">
      <div class="stage-content transition-opacity duration-500">
        <div class="absolute top-14 left-14 hidden w-[920px] lg:block">
          <Desktop />
        </div>
        <div class="absolute top-10 left-1/2 -translate-x-1/2 lg:right-14 lg:left-auto lg:translate-x-0">
          <Phone />
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-32 max-w-6xl px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <h2 class="text-[40px] leading-[1.05] font-[550] tracking-[-0.035em]">One sentence to your agent</h2>
      <p class="mt-4 text-lg leading-relaxed text-gray-500">
        Each tab is something you'd ask your agent, the commands it runs, and what shows up in rply.
      </p>
    </div>
    <Scenarios />
  </section>

  <section class="mt-32 overflow-hidden">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="max-w-xl text-[40px] leading-[1.05] font-[550] tracking-[-0.035em]">Ask for it in plain words</h2>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-gray-500">
        Your agent reads <code class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-[15px]">rply guide</code> once and
        knows every command. After that, a sentence is enough.
      </p>
    </div>
    <div class="marquee mt-10 flex flex-col gap-3 [mask-image:linear-gradient(90deg,transparent,black_10%,black_90%,transparent)]">
      {
        prompts.map((row, r) => (
          <div class="flex w-max gap-3" style={`animation: marquee ${r ? 70 : 60}s linear infinite ${r ? "reverse" : ""}`}>
            {[...row, ...row].map((text) => (
              <span class="rounded-xl bg-gray-100 px-4 py-2.5 text-[15px] whitespace-nowrap text-gray-700">{text}</span>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-32 border-t border-gray-200 bg-gray-100">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 py-20 md:grid-cols-2">
      <div>
        <h2 class="text-[32px] leading-tight font-[550] tracking-[-0.03em]">Works with what you already run</h2>
        <p class="mt-4 max-w-md text-[15px] leading-relaxed text-gray-500">
          rply is a CLI, so there's no SDK and no MCP setup. If it can run a shell command, it can reach you.
        </p>
      </div>
      <ul class="grid grid-cols-2 content-start gap-x-8 text-[15px]">
        {runsOn.map((name) => <li class="border-b border-gray-200 py-2.5">{name}</li>)}
      </ul>
    </div>
  </section>

  <section class="border-t border-gray-200">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-20 md:grid-cols-2">
      <div>
        <h2 class="text-[32px] leading-tight font-[550] tracking-[-0.03em]">Open source, and yours to run</h2>
        <p class="mt-4 max-w-md text-[15px] leading-relaxed text-gray-500">
          One Docker image with SQLite. Put it on Railway, a VPS, or next to your agent on exe.dev. Push notifications
          still work.
        </p>
        <div class="mt-6 flex gap-3">
          <a href="/self-host/" class="btn btn-primary">Self-host rply</a>
          <a href="https://github.com/joshuaKnauber/rply" class="btn btn-outline">View on GitHub</a>
        </div>
      </div>
      <pre class="overflow-x-auto rounded-xl bg-gray-900 p-5 font-mono text-[13px] leading-6 text-gray-300"><span class="text-gray-500">$</span> npx @rply/cli init https://rply.example.com
<span class="text-gray-500">Channel "SEO bot" created. Open the link to pair:</span>
<span class="text-brand-300">https://rply.example.com/pair?c=K7QX-M2PD</span>
<span class="text-gray-500">$</span> rply guide setup</pre>
    </div>
  </section>

  <section class="border-t border-gray-200">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 py-20 md:grid-cols-[1fr_2fr]">
      <h2 class="text-[32px] leading-tight font-[550] tracking-[-0.03em]">Fair questions</h2>
      <dl class="divide-y divide-gray-200 border-y border-gray-200">
        {
          faqs.map((f) => (
            <div class="py-5">
              <dt class="text-[15px] font-medium text-gray-900">{f.q}</dt>
              <dd class="mt-1.5 max-w-xl text-[15px] leading-relaxed text-gray-500">{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="flex flex-col items-center rounded-3xl bg-linear-to-b from-gray-100 to-[#eceefb] px-6 py-20 text-center">
      <span class="grid size-14 place-items-center rounded-2xl border border-brand-600 bg-linear-to-b from-brand-400 to-brand-500 text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.3)]">
        <Bird class="size-7" />
      </span>
      <h2 class="mt-6 text-[40px] leading-[1.05] font-[550] tracking-[-0.035em]">Let your agents reach you</h2>
      <p class="mt-3 text-gray-500">Free and open source. Works with any agent.</p>
      <a href="/docs/start/quickstart/" class="btn btn-primary mt-8">Get started</a>
    </div>
  </section>

  <footer class="border-t border-gray-200">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-6 px-6 py-8 pb-20 text-sm text-gray-500">
      <span class="flex items-center gap-2 text-gray-900"><Bird class="size-4" /> rply.sh</span>
      <a href="/docs/start/introduction/" class="hover:text-gray-900">Docs</a>
      <a href="/self-host/" class="hover:text-gray-900">Self-host</a>
      <a href="/compare/" class="hover:text-gray-900">Compare</a>
      <a href="https://www.npmjs.com/package/@rply/cli" class="hover:text-gray-900">npm</a>
      <span class="ml-auto">Free and open source</span>
    </div>
  </footer>
</Lab>

<style>
  .marquee:hover > div {
    animation-play-state: paused !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee > div {
      animation: none !important;
      flex-wrap: wrap;
      width: auto;
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>(".stage")!;
  const content = stage.querySelector<HTMLElement>(".stage-content")!;
  const finger = stage.querySelector<HTMLElement>(".finger")!;
  const states = ["s-drafted", "s-ask", "opened", "answered", "done"];
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
  let answered: (() => void) | null = null;

  const setStatus = (text: string, width: string, instant = false) => {
    stage.querySelectorAll(".status-text").forEach((el) => (el.textContent = text));
    stage.querySelectorAll<HTMLElement>(".bar").forEach((bar) => {
      bar.style.transition = instant ? "none" : "";
      bar.style.width = width;
      if (instant) {
        void bar.offsetWidth;
        bar.style.transition = "";
      }
    });
  };

  const answer = () => {
    if (!stage.classList.contains("s-ask") || stage.classList.contains("answered")) return;
    stage.classList.add("opened", "answered");
    setStatus("0 of 5 live", "0", true);
    setStatus("0 of 5 live", "100%");
    for (let i = 1; i <= 5; i++) setTimeout(() => setStatus(i < 5 ? `${i} of 5 live` : "All 5 live", "100%"), i * 500);
    answered?.();
  };

  const tap = async (el: HTMLElement) => {
    const box = finger.parentElement!.getBoundingClientRect();
    const r = el.getBoundingClientRect();
    finger.style.left = `${r.left - box.left + r.width / 2}px`;
    finger.style.top = `${r.top - box.top + r.height / 2}px`;
    finger.animate(
      [
        { opacity: 0, transform: "scale(1.4)" },
        { opacity: 1, transform: "scale(1)", offset: 0.35 },
        { opacity: 1, transform: "scale(0.85)", offset: 0.65 },
        { opacity: 0, transform: "scale(1)" },
      ],
      { duration: 700, easing: "ease-out" },
    );
    await wait(350);
  };

  stage.querySelectorAll("[data-choice]").forEach((b) => b.addEventListener("click", answer));

  async function loop() {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      stage.classList.add("s-drafted", "s-ask", "opened");
      setStatus("Waiting for you", "0", true);
      return;
    }
    while (true) {
      stage.classList.remove(...states);
      setStatus("Drafting, 4 of 5", "80%", true);
      content.style.opacity = "1";
      await wait(1200);
      stage.classList.add("s-drafted");
      setStatus("Waiting for you", "0", true);
      await wait(1400);
      stage.classList.add("s-ask");
      const userAnswered = new Promise<void>((resolve) => (answered = resolve));
      await Promise.race([userAnswered, wait(3800)]);
      if (!stage.classList.contains("answered")) {
        await tap(stage.querySelector<HTMLElement>("[data-tap]")!);
        answer();
      }
      await wait(2800);
      stage.classList.add("done");
      await wait(5000);
      content.style.opacity = "0";
      await wait(500);
    }
  }
  loop();

  document.querySelectorAll<HTMLElement>("[data-copy]").forEach((el) =>
    el.addEventListener("click", () => navigator.clipboard.writeText(el.dataset.copy!)),
  );
</script>
