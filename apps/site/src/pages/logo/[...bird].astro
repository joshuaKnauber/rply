---
import "@fontsource-variable/inter/opsz.css";
import "@fontsource-variable/geist-mono";
import AppIcon from "../../components/logo/AppIcon.astro";
import { scenes, sceneKeys } from "../../components/logo/scenes.ts";
import { birds, birdKeys, type BirdKey } from "../../components/logo/birds.ts";

export function getStaticPaths() {
  return [{ params: { bird: undefined } }, ...birdKeys.map((bird) => ({ params: { bird } }))];
}
const bird = (Astro.params.bird ?? "chick") as BirdKey;
const previews = ["jelly", "ceramic", "night"] as const;

const ladder = [128, 64, 48, 32, 20, 16];
const toggles = [
  { key: "eye", options: ["ink", "sparkle", "happy"] },
  { key: "blush", options: ["off", "on"] },
  { key: "gloss", options: ["off", "on"] },
  { key: "grain", options: ["off", "on"] },
  { key: "motion", options: ["off", "on"] },
];
---

<html lang="en" data-eye="sparkle" data-blush="on" data-gloss="on" data-grain="on" data-motion="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>rply · logo lab</title>
  </head>
  <body>
    <header>
      <div class="title">
        <AppIcon bird={bird} scene="none" size={22} eye="ink" />
        <span>logo lab</span>
      </div>
      <div class="toggles">
        {
          toggles.map((t) => (
            <div class="seg" data-toggle={t.key}>
              <span>{t.key}</span>
              {t.options.map((o) => (
                <button data-value={o}>{o}</button>
              ))}
            </div>
          ))
        }
      </div>
    </header>

    <main>
      <section class="birds">
        <h2>Birds</h2>
        <div class="bird-grid">
          {
            birdKeys.map((k) => (
              <a class:list={["bird-card", k === bird && "on"]} href={`/logo/${k}/`} data-bird={k}>
                <div class="bird-row">
                  <AppIcon bird={k} scene="none" size={92} color="#6f7ef6" />
                  {previews.map((sc) => <AppIcon bird={k} scene={sc} size={92} />)}
                </div>
                <strong>{birds[k].label}</strong>
                <span>{birds[k].note}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hero">
        <button class="stage" id="next" aria-label="Next background">
          {
            sceneKeys.map((k) => (
              <div data-scene={k} class="pick">
                <AppIcon bird={bird} scene={k} size={300} />
              </div>
            ))
          }
        </button>
        <p class="caption"><strong id="scene-name"></strong> · click for the next one</p>
      </section>

      <section>
        <h2>Backgrounds</h2>
        <div class="grid">
          {
            sceneKeys.map((k) => (
              <button class="tile" data-select={k}>
                <AppIcon bird={bird} scene={k} size={136} />
                <span>{scenes[k].label}</span>
              </button>
            ))
          }
        </div>
      </section>

      <section>
        <h2>Sizes</h2>
        <div class="ladders">
          {
            ["light", "dark"].map((bg) => (
              <div class:list={["ladder", bg]}>
                {ladder.map((s) =>
                  sceneKeys.map((k) => (
                    <div data-scene={k} class="pick">
                      <AppIcon bird={bird} scene={k} size={s} />
                    </div>
                  )),
                )}
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h2>In context</h2>
        <div class="contexts">
          <div class="tabbar">
            <div class="tab">
              {
                sceneKeys.map((k) => (
                  <span data-scene={k} class="pick">
                    <AppIcon bird={bird} scene={k} size={16} />
                  </span>
                ))
              }
              <span>rply · SEO bot</span>
            </div>
            <div class="tab muted"><span class="dot"></span><span>Docs</span></div>
          </div>
          <div class="homescreen">
            <div class="app">
              {
                sceneKeys.map((k) => (
                  <span data-scene={k} class="pick">
                    <AppIcon bird={bird} scene={k} size={64} />
                  </span>
                ))
              }
              <span>rply</span>
            </div>
            {["Mail", "Notes", "Photos"].map((n) => <div class="app"><span class="ghost" /><span>{n}</span></div>)}
          </div>
          <div class="notif">
            {
              sceneKeys.map((k) => (
                <span data-scene={k} class="pick">
                  <AppIcon bird={bird} scene={k} size={38} />
                </span>
              ))
            }
            <div>
              <strong>SEO bot</strong>
              <p>❓ Publish these 5 pages?</p>
            </div>
            <time>now</time>
          </div>
        </div>
      </section>

      <section>
        <h2>Just the bird</h2>
        <div class="marks">
          <div class="mark light"><AppIcon bird={bird} scene="none" size={120} /></div>
          <div class="mark light"><AppIcon bird={bird} scene="none" size={120} color="#1d1f3f" eye="happy" blush={false} /></div>
          <div class="mark brand"><AppIcon bird={bird} scene="none" size={120} color="#fff" /></div>
          <div class="mark dark"><AppIcon bird={bird} scene="none" size={120} color="#aab3ff" /></div>
          <div class="mark peach"><AppIcon bird={bird} scene="none" size={120} color="#6f7ef6" eye="sparkle" blush /></div>
        </div>
      </section>

      <section>
        <h2>Lockups</h2>
        <div class="lockups">
          <div class="lockup light">
            <AppIcon bird={bird} scene="none" size={44} />
            <span>rply</span>
          </div>
          <div class="lockup dark">
            <AppIcon bird={bird} scene="none" size={44} color="#fff" />
            <span>rply</span>
          </div>
          <div class="lockup light">
            {
              sceneKeys.map((k) => (
                <span data-scene={k} class="pick">
                  <AppIcon bird={bird} scene={k} size={48} />
                </span>
              ))
            }
            <span>rply</span>
          </div>
          <div class="lockup light small">
            <AppIcon bird={bird} scene="none" size={20} eye="ink" />
            <span>rply</span>
          </div>
        </div>
      </section>
    </main>

    <script>
      const root = document.documentElement;
      const keys = [...document.querySelectorAll<HTMLElement>(".tile")].map((t) => t.dataset.select!);
      const labels = Object.fromEntries([...document.querySelectorAll<HTMLElement>(".tile")].map((t) => [t.dataset.select, t.querySelector("span")!.textContent]));
      let current = location.hash.slice(1) || keys[0];

      function select(key: string) {
        current = keys.includes(key) ? key : keys[0];
        document.querySelectorAll<HTMLElement>(".pick").forEach((el) => el.classList.toggle("on", el.dataset.scene === current));
        document.querySelectorAll<HTMLElement>(".tile").forEach((el) => el.classList.toggle("on", el.dataset.select === current));
        document.getElementById("scene-name")!.textContent = labels[current]!;
        history.replaceState(null, "", `#${current}`);
        document.querySelectorAll<HTMLAnchorElement>(".bird-card").forEach((a) => (a.href = `/logo/${a.dataset.bird}/#${current}`));
      }

      document.getElementById("next")!.addEventListener("click", () => select(keys[(keys.indexOf(current) + 1) % keys.length]));
      document.querySelectorAll<HTMLElement>(".tile").forEach((t) => t.addEventListener("click", () => select(t.dataset.select!)));

      document.querySelectorAll<HTMLElement>("[data-toggle]").forEach((seg) => {
        const key = seg.dataset.toggle!;
        const sync = () => seg.querySelectorAll<HTMLElement>("button").forEach((b) => b.classList.toggle("on", root.dataset[key] === b.dataset.value));
        seg.querySelectorAll<HTMLElement>("button").forEach((b) =>
          b.addEventListener("click", () => {
            root.dataset[key] = b.dataset.value;
            sync();
          }),
        );
        sync();
      });

      select(current);
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: "Inter Variable", system-ui, sans-serif;
    font-feature-settings: "cv11", "ss03";
    color: #2a2a27;
    background: #f7f6f3;
    -webkit-font-smoothing: antialiased;
  }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  svg.rply-icon { display: block; overflow: visible; }

  header {
    position: sticky; top: 0; z-index: 10;
    display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between;
    padding: 12px 24px;
    background: rgb(247 246 243 / .85); backdrop-filter: blur(12px);
    border-bottom: 1px solid #e8e6e1;
  }
  .title { display: flex; gap: 8px; align-items: center; font-weight: 600; letter-spacing: -.01em; }
  .toggles { display: flex; flex-wrap: wrap; gap: 8px; }
  .seg { display: flex; align-items: center; gap: 2px; padding: 3px; border-radius: 10px; background: #ecebe7; font-size: 12px; }
  .seg > span { padding: 0 6px; color: #8a8880; font-family: "Geist Mono Variable", monospace; font-size: 11px; }
  .seg button { padding: 4px 9px; border-radius: 7px; color: #6a6860; }
  .seg button.on { background: #fff; color: #2a2a27; box-shadow: 0 1px 2px rgb(0 0 0 / .08); }

  main { max-width: 1080px; margin: 0 auto; padding: 32px 24px 96px; }
  section { margin-top: 56px; }
  h2 { font-family: "Geist Mono Variable", monospace; font-size: 11px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: #8a8880; margin: 0 0 16px; }

  .pick { display: none; }
  .pick.on { display: contents; }

  .birds { margin-top: 8px; }
  .bird-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(460px, 1fr)); gap: 12px; }
  .bird-card { display: flex; flex-direction: column; gap: 2px; padding: 18px 18px 14px; border-radius: 20px; color: inherit; text-decoration: none; font-size: 13px; }
  .bird-card:hover { background: #efeee9; }
  .bird-card.on { background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / .05), 0 8px 24px rgb(0 0 0 / .05); }
  .bird-card span { color: #8a8880; }
  .bird-row { display: flex; align-items: center; gap: 14px; margin-bottom: 10px; }
  .bird-row svg:not(.is-bare) { filter: drop-shadow(0 6px 12px rgb(42 42 39 / .12)); }
  .hero { margin-top: 24px; display: flex; flex-direction: column; align-items: center; }
  .stage { padding: 30px; border-radius: 40px; transition: transform 220ms cubic-bezier(.34, 1.56, .64, 1); }
  .stage:hover { transform: scale(1.02) rotate(-1deg); }
  .stage:active { transform: scale(.97); }
  .stage svg { filter: drop-shadow(0 2px 3px rgb(42 42 39 / .08)) drop-shadow(0 24px 40px rgb(42 42 39 / .16)); }
  .caption { margin: 8px 0 0; font-size: 14px; color: #8a8880; }
  .caption strong { color: #2a2a27; font-weight: 500; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .tile { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 16px 8px 12px; border-radius: 18px; font-size: 13px; color: #6a6860; }
  .tile:hover { background: #efeee9; }
  .tile.on { background: #fff; color: #2a2a27; box-shadow: 0 1px 2px rgb(0 0 0 / .05), 0 8px 24px rgb(0 0 0 / .05); }
  .tile svg { filter: drop-shadow(0 6px 12px rgb(42 42 39 / .12)); }

  .ladders { display: grid; gap: 12px; }
  .ladder { display: flex; align-items: end; gap: 28px; padding: 28px; border-radius: 20px; }
  .ladder.light { background: #fff; }
  .ladder.dark { background: #1b1b1f; }

  .contexts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .tabbar { grid-column: 1 / -1; display: flex; gap: 4px; padding: 8px 8px 0; border-radius: 14px 14px 0 0; background: #dedcd6; }
  .tab { display: flex; align-items: center; gap: 8px; width: 220px; padding: 9px 12px; border-radius: 10px 10px 0 0; background: #fff; font-size: 12px; }
  .tab.muted { background: transparent; color: #6a6860; }
  .tab .dot { width: 14px; height: 14px; border-radius: 4px; background: #c4c1b9; }
  .homescreen {
    display: flex; gap: 22px; justify-content: center; padding: 36px 20px; border-radius: 20px;
    background: linear-gradient(160deg, #f3c9b5, #b9a5e8 55%, #7f8fd8);
  }
  .app { display: flex; flex-direction: column; align-items: center; gap: 6px; font-size: 11px; color: #fff; text-shadow: 0 1px 2px rgb(0 0 0 / .25); }
  .ghost { width: 64px; height: 64px; border-radius: 15px; background: rgb(255 255 255 / .35); }
  .notif {
    align-self: center; display: flex; gap: 12px; align-items: center; padding: 12px 14px; border-radius: 22px;
    background: rgb(255 255 255 / .8); box-shadow: 0 10px 30px rgb(0 0 0 / .08); font-size: 13px;
  }
  .notif div { flex: 1; }
  .notif p { margin: 2px 0 0; color: #4a4a45; }
  .notif time { align-self: start; color: #8a8880; font-size: 12px; }

  .marks { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
  .mark { display: grid; place-items: center; aspect-ratio: 1; border-radius: 20px; }
  .mark.light { background: #fff; }
  .mark.brand { background: #6f7ef6; }
  .mark.dark { background: #1b1b1f; }
  .mark.peach { background: #ffe6d8; }

  .lockups { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
  .lockup { display: flex; align-items: center; justify-content: center; gap: 12px; padding: 40px 20px; border-radius: 20px; font-size: 40px; font-weight: 650; letter-spacing: -.045em; }
  .lockup.light { background: #fff; color: #1d1f3f; }
  .lockup.dark { background: #1b1b1f; color: #fff; }
  .lockup.small { font-size: 18px; gap: 7px; letter-spacing: -.03em; }

  [data-eye="happy"] .eye-ink, [data-eye="happy"] .eye-sparkle,
  [data-eye="ink"] .eye-sparkle, [data-eye="ink"] .eye-happy,
  [data-eye="sparkle"] .eye-ink, [data-eye="sparkle"] .eye-happy,
  [data-blush="off"] .blush,
  [data-gloss="off"] .gloss,
  [data-grain="off"] .grain,
  .rply-icon .hidden,
  .is-small .glare, .is-small .grain { display: none; }

  .rply-icon .stitch { transform-box: fill-box; transform-origin: center; transform: scale(.88); }
  .rply-icon .blink, .rply-icon .bird { transform-box: fill-box; transform-origin: center; }
  .rply-icon .bird { transition: transform 300ms cubic-bezier(.34, 1.56, .64, 1); }
  .stage:hover .bird, .tile:hover .bird, .mark:hover .bird { transform: rotate(-6deg) translateY(-3%); }

  [data-motion="on"] .rply-icon .blink { animation: blink 4.5s infinite; }
  [data-motion="on"] .rply-icon .twinkle { animation: twinkle 3s ease-in-out infinite; animation-delay: calc(var(--d) * -1s); }
  [data-motion="on"] .rply-icon .drift { animation: drift 14s ease-in-out infinite alternate; animation-delay: calc(var(--d) * -3s); }
  [data-motion="on"] .rply-icon .bob { animation: bob 6s ease-in-out infinite; animation-delay: calc(var(--d) * -1s); }
  [data-motion="on"] .rply-icon .rise { animation: rise 7s ease-in infinite; animation-delay: calc(var(--d) * -1.2s); }
  [data-motion="on"] .rply-icon .cursor { animation: cursor 1.1s steps(1) infinite; }

  @keyframes blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(.1); } }
  @keyframes twinkle { 50% { opacity: .15; } }
  @keyframes drift { to { transform: translateX(30px); } }
  @keyframes bob { 50% { transform: translateY(-10px); } }
  @keyframes rise { 0% { transform: translateY(30px); opacity: 0; } 20% { opacity: 1; } 100% { transform: translateY(-120px); opacity: 0; } }
  @keyframes cursor { 50% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .rply-icon * { animation: none !important; }
  }
</style>
