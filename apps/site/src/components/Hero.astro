---
import Phone from "./Phone.astro";
import HeroDemo from "./HeroDemo.astro";
import StoreBadges from "./StoreBadges.astro";
import Mark from "./Mark.astro";
---

<div
  class="relative isolate mx-auto grid max-w-5xl items-center gap-12 px-6 pt-8 pb-12 md:grid-cols-[1fr_auto] after:absolute after:-right-[200px] after:-bottom-[160px] after:-z-10 after:h-[620px] after:w-[900px] after:bg-[radial-gradient(closest-side,rgb(150_140_240/0.3),transparent)]"
>
  <div>
    <h1 class="mb-5">Agent notifications<br />made easy</h1>
    <p class="mb-9 max-w-120 text-lead text-muted">
      Push notifications from any agent, plus <Mark>questions you can answer</Mark> and a live status. One command to set up.
    </p>
    <StoreBadges />
  </div>
  <Phone><HeroDemo /></Phone>
</div>
