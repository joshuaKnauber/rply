---
import SectionHeading from "./SectionHeading.astro";
import Mark from "./Mark.astro";

const tabs = ["Approvals", "Live status", "New work", "API keys"];
const card = "rounded-2xl border border-line bg-white p-5 shadow-[0_1px_2px_rgb(0_0_0/0.04)]";
const label = "font-mono text-caption tracking-[0.06em] text-muted uppercase";
---

<section id="features" class="scroll-mt-8 py-24">
  <SectionHeading>
    <Fragment slot="title">Your agent keeps working.<br />You stay in charge.</Fragment>
    Each tab is <Mark>one command</Mark> your agent runs, and what shows up on your phone.
  </SectionHeading>

  <div class="features">
    <div class="mx-auto mb-6 flex w-fit flex-wrap justify-center gap-1 rounded-full bg-black/5 p-1">
      {
        tabs.map((tab, i) => (
          <button
            data-tab={i}
            aria-selected={i === 0 ? "true" : "false"}
            class="cursor-pointer rounded-full px-5 py-2 text-ui text-muted aria-selected:bg-white aria-selected:text-ink aria-selected:shadow-[0_1px_2px_rgb(0_0_0/0.08)]"
          >
            {tab}
          </button>
        ))
      }
    </div>

    <div class="rounded-3xl bg-[#f1f0ec] p-6 md:p-10">
      <div data-panel="0" class="grid items-center gap-6 md:grid-cols-[1fr_auto_1.2fr]">
        <div class={card}>
          <p class={label}>Your agent runs</p>
          <pre class="mt-3 font-mono text-small whitespace-pre-wrap"><span class="text-muted">$</span> rply ask "Publish 5 new pages?" \
    --choices Publish,"Not yet" --wait</pre>
          <p class="mt-3 font-mono text-small text-accent-600">Publish</p>
          <p class="mt-4 text-small text-secondary">It waits for your answer, then carries on. No polling code, no webhook.</p>
        </div>
        <span class="hidden text-lead text-muted md:block">→</span>
        <div class={card}>
          <p class={label}>SEO bot · acme.dev</p>
          <p class="mt-3">I drafted 5 new pages for acme.dev. Publish them now?</p>
          <div class="mt-4 flex gap-2">
            <span class="flex-1 rounded-lg bg-ink py-2 text-center text-small text-white">Publish</span>
            <span class="flex-1 rounded-lg border border-line py-2 text-center text-small text-muted">Not yet</span>
          </div>
          <p class="mt-3 text-caption text-muted">Answered from the lock screen · 9:42</p>
        </div>
      </div>

      <div data-panel="1" hidden class="grid items-center gap-6 md:grid-cols-[1fr_auto_1.2fr]">
        <div class={card}>
          <p class={label}>Your agent runs</p>
          <pre class="mt-3 font-mono text-small whitespace-pre-wrap"><span class="text-muted">$</span> rply status set --blocks status.json
<span class="text-muted">$</span> rply status patch \
    --patch '{`{"id":"live","value":42}`}'</pre>
          <p class="mt-4 text-small text-secondary">
            One status page per agent, pinned on top and updated in place. No dashboard to build or host.
          </p>
        </div>
        <span class="hidden text-lead text-muted md:block">→</span>
        <div class={card}>
          <p class={label}>📌 Status</p>
          <div class="mt-4 grid grid-cols-3 gap-3">
            <div><p class="text-h3">42</p><p class="text-caption text-muted">Pages live</p></div>
            <div><p class="text-h3">38</p><p class="text-caption text-muted">Indexed</p></div>
            <div><p class="text-h3 text-green-600">+38%</p><p class="text-caption text-muted">Clicks</p></div>
          </div>
          <div class="mt-5 flex justify-between text-small"><span>Writing /pricing</span><span class="text-muted">3 of 5</span></div>
          <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-neutral-200"><div class="h-full w-3/5 bg-accent-500"></div></div>
        </div>
      </div>

      <div data-panel="2" hidden class="grid items-center gap-6 md:grid-cols-[1fr_auto_1.2fr]">
        <div class={card}>
          <p class={label}>You send</p>
          <p class="mt-3 ml-auto w-fit rounded-2xl bg-ink px-4 py-2 text-white">Add pages for the new pricing plans</p>
          <p class="mt-3 text-right text-caption text-amber-600">Working on it</p>
        </div>
        <span class="hidden text-lead text-muted md:block">→</span>
        <div class={card}>
          <p class={label}>Your agent runs</p>
          <pre class="mt-3 font-mono text-small whitespace-pre-wrap"><span class="text-muted">$</span> rply inbox --wait</pre>
          <p class="mt-2 font-mono text-small text-accent-600">"Add pages for the new pricing plans"</p>
          <pre class="mt-3 font-mono text-small whitespace-pre-wrap"><span class="text-muted">$</span> rply ack msg_8f2 working</pre>
          <p class="mt-4 text-small text-secondary">
            Hand it new work whenever you think of it. It picks it up on its next check and tells you it's on it.
          </p>
        </div>
      </div>

      <div data-panel="3" hidden class="grid items-center gap-6 md:grid-cols-[1fr_auto_1.2fr]">
        <div class={card}>
          <p class={label}>Your agent runs · coming soon</p>
          <pre class="mt-3 font-mono text-small whitespace-pre-wrap"><span class="text-muted">$</span> rply secret request OPENAI_API_KEY \
    --to .env --wait</pre>
          <p class="mt-3 font-mono text-small text-accent-600">OPENAI_API_KEY written to .env</p>
          <p class="mt-4 text-small text-secondary">
            The key is encrypted on your phone and written straight to the file. It never shows up in the chat or the
            agent's context.
          </p>
        </div>
        <span class="hidden text-lead text-muted md:block">→</span>
        <div class={card}>
          <p class={label}>🔑 SEO bot needs a key</p>
          <p class="mt-3">OPENAI_API_KEY <span class="text-muted">→ .env</span></p>
          <p class="text-small text-muted">For keyword research</p>
          <div class="mt-4 rounded-lg border border-line px-3 py-2 font-mono text-small tracking-widest text-muted">••••••••••••••••</div>
          <span class="mt-3 block rounded-lg bg-ink py-2 text-center text-small text-white">Send securely</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".features").forEach((features) => {
    features.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((button) => {
      button.addEventListener("click", () => {
        features.querySelectorAll("[data-tab]").forEach((b) => b.setAttribute("aria-selected", String(b === button)));
        features.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
          panel.hidden = panel.dataset.panel !== button.dataset.tab;
        });
      });
    });
  });
</script>
