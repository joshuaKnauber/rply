---
import Default from "@astrojs/starlight/components/ThemeSelect.astro";
---

<Default />
<a href="https://app.rply.sh" class="go-to-app">Go to app</a>

<style>
  .go-to-app {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding: 0 0.75rem;
    margin-inline-start: 0.5rem;
    border: 1px solid var(--rply-brand-600);
    border-radius: 0.5rem;
    background: linear-gradient(to bottom, var(--rply-brand-400), var(--rply-brand));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.3), 0 1px 2px rgb(0 0 0 / 0.08);
    color: white;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .go-to-app:hover {
    filter: brightness(1.05);
  }
  @media (max-width: 50rem) {
    .go-to-app {
      display: none;
    }
  }
</style>
