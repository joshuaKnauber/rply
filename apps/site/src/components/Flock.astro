---
interface Props {
  subtle?: boolean;
}
const { subtle = false } = Astro.props;
---

<canvas class="flock pointer-events-none absolute inset-0 -z-[2] size-full" data-subtle={subtle ? "" : undefined} aria-hidden="true"></canvas>

<script>
  import { birdPath } from "./bird.ts";

  type Bird = { x: number; y: number; vx: number; vy: number; depth: number; phase: number; burst: boolean };

  const shape = new Path2D(birdPath);
  const far = [203, 208, 255];
  const near = [111, 126, 246];
  const mix = (d: number) => far.map((c, i) => Math.round(c + (near[i] - c) * d)).join(",");

  document.querySelectorAll<HTMLCanvasElement>("canvas.flock").forEach((canvas) => {
    const box = canvas.parentElement!;
    const ctx = canvas.getContext("2d")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const subtle = canvas.dataset.subtle !== undefined;
    let width = 0;
    let height = 0;
    let birds: Bird[] = [];
    let pointer: { x: number; y: number } | null = null;
    let frame = 0;
    let last = 0;

    const speed = (b: Bird) => (subtle ? 0.2 + b.depth * 0.6 : 0.35 + b.depth * 1.3);
    const size = (b: Bird) => (subtle ? 10 + b.depth * 22 : 10 + b.depth * 26);

    const spawn = (x: number, y: number, burst = false): Bird => {
      const depth = burst ? 0.6 + Math.random() * 0.4 : Math.random() ** 1.6;
      const angle = burst ? Math.random() * Math.PI * 2 : 0;
      const kick = burst ? 3 + Math.random() * 3 : 0;
      return { x, y, vx: Math.cos(angle) * kick, vy: Math.sin(angle) * kick, depth, phase: Math.random() * Math.PI * 2, burst };
    };

    const resize = () => {
      const dpr = Math.min(devicePixelRatio, 2);
      width = box.clientWidth;
      height = box.clientHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round((width * height) / (subtle ? 14000 : 9000));
      birds = Array.from({ length: count }, () => spawn(Math.random() * width, Math.random() * height)).sort((a, b) => a.depth - b.depth);
      draw(0);
    };

    const draw = (time: number) => {
      ctx.clearRect(0, 0, width, height);
      for (const b of birds) {
        const s = size(b);
        const flap = 1 + Math.sin(time * 0.012 + b.phase) * 0.07;
        ctx.save();
        ctx.translate(b.x, b.y + Math.sin(time * 0.002 + b.phase) * 6 * b.depth);
        ctx.rotate(Math.atan2(b.vy, Math.max(b.vx, 0.5)) * 0.6);
        ctx.scale(s / 442, (s / 442) * flap);
        ctx.translate(-221, -208);
        ctx.fillStyle = `rgba(${mix(b.depth)},${subtle ? 0.1 + b.depth * 0.2 : 0.35 + b.depth * 0.55})`;
        ctx.fill(shape, "evenodd");
        ctx.restore();
      }
    };

    const step = (time: number) => {
      const dt = Math.min((time - (last || time)) / 16.7, 3);
      last = time;
      for (const b of birds) {
        if (pointer) {
          const dx = b.x - pointer.x;
          const dy = b.y - pointer.y;
          const dist = Math.hypot(dx, dy);
          if (dist < 140 && dist > 0) {
            const push = (1 - dist / 140) * 0.9 * dt;
            b.vx += (dx / dist) * push;
            b.vy += (dy / dist) * push;
          }
        }
        b.vx += (speed(b) - b.vx) * 0.03 * dt;
        b.vy *= 0.94 ** dt;
        b.x += b.vx * dt;
        b.y += b.vy * dt;
        const s = size(b);
        if (b.x > width + s && !b.burst) Object.assign(b, spawn(-s, Math.random() * height));
        if (b.y < -s) b.y = height + s;
        if (b.y > height + s) b.y = -s;
      }
      birds = birds.filter((b) => !b.burst || b.x < width + size(b));
      draw(time);
      frame = requestAnimationFrame(step);
    };

    const start = () => {
      if (reduced || frame) return;
      last = 0;
      frame = requestAnimationFrame(step);
    };
    const stop = () => {
      cancelAnimationFrame(frame);
      frame = 0;
    };

    new ResizeObserver(resize).observe(box);
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop())).observe(box);

    if (subtle) return;
    box.addEventListener("pointermove", (e) => {
      const r = box.getBoundingClientRect();
      pointer = { x: e.clientX - r.left, y: e.clientY - r.top };
    });
    box.addEventListener("pointerleave", () => (pointer = null));
    box.addEventListener("click", (e) => {
      if (reduced || (e.target as HTMLElement).closest("a, button")) return;
      const r = box.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      for (let i = 0; i < 14; i++) birds.push(spawn(x, y, true));
      birds.sort((a, b) => a.depth - b.depth);
    });
  });
</script>
