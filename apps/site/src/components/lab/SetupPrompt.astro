---
import Icon from "./Icon.astro";
import { platforms, setupPrompt } from "./setup.ts";

const prompt = setupPrompt(platforms[0].where);
---

<button class="hero-setup btn btn-primary h-12 px-6 text-base" data-prompt={prompt}>
  <Icon name="copy" class="size-4" /> <span>Copy setup prompt</span>
</button>

<script>
  document.querySelectorAll<HTMLElement>(".hero-setup").forEach((button) => {
    const label = button.querySelector("span")!;
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.prompt!);
      label.textContent = "Copied, paste it into your agent";
      setTimeout(() => (label.textContent = "Copy setup prompt"), 2500);
    });
  });
</script>
