---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { siClaude, siGooglegemini, siRailway, siFlydotio, siRender, siHetzner } from "simple-icons";
import { platforms, setupPrompt } from "./setup.ts";

const tiles: Record<string, { bg: string; path?: string; src?: string; fg?: string }> = {
  exe: { bg: "bg-white", src: "/logos/exe.png" },
  railway: { bg: "bg-gray-950", path: siRailway.path, fg: "#fff" },
  fly: { bg: "bg-[#24175B]", path: siFlydotio.path, fg: "#fff" },
  render: { bg: "bg-gray-950", path: siRender.path, fg: "#fff" },
  vps: { bg: "bg-[#D50C2D]", path: siHetzner.path, fg: "#fff" },
};
const [auto, ...rest] = platforms;
const tile = "grid place-items-center rounded-[22%] ring-1 ring-black/5 shadow-[0_1px_2px_rgb(0_0_0/0.06),0_8px_18px_-12px_rgb(0_0_0/0.35)]";
const option =
  "group relative rounded-2xl border border-gray-200 bg-white text-left transition-colors hover:bg-gray-50 aria-checked:border-brand-500 aria-checked:bg-white aria-checked:ring-1 aria-checked:ring-brand-500";

const agents = ["claude", "codex", "cursor", "gemini", "openclaw"] as const;
---

<section id="get-started" class="get-started mx-auto mt-32 max-w-6xl scroll-mt-8 px-6">
  <h2 class="text-center text-[40px] leading-[1.05] font-[550] tracking-[-0.035em]">Get started</h2>
  <p class="mt-3 text-center text-lg text-gray-500">Where should your rply server run?</p>

  <div class="mt-10 grid gap-3 sm:grid-cols-2 md:grid-cols-4 md:grid-rows-2" role="radiogroup" aria-label="Where should your rply server run?">
    <button role="radio" data-platform={auto.key} aria-checked="true" class:list={[option, "flex flex-col p-6 md:row-span-2"]}>
      <span class="flex -space-x-2">
        <span class:list={[tile, "size-11 bg-[#D97757]"]}><svg viewBox="0 0 24 24" class="size-6" fill="#fff" aria-hidden="true"><path d={siClaude.path} /></svg></span>
        <span class:list={[tile, "size-11 bg-white"]}><img src="/logos/openai.svg" alt="" class="size-6" /></span>
        <span class:list={[tile, "size-11 bg-white"]}><svg viewBox="0 0 24 24" class="size-6" fill="#8E75B2" aria-hidden="true"><path d={siGooglegemini.path} /></svg></span>
      </span>
      <span class="mt-auto pt-10">
        <span class="inline-flex rounded-full bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700">Recommended</span>
        <span class="mt-2 block text-xl font-[550] tracking-[-0.02em] text-gray-900">{auto.label}</span>
        <span class="mt-1 block text-sm text-gray-500">It hosts the server itself if it can, or asks you.</span>
      </span>
      <span class="absolute top-5 right-5 grid size-5 place-items-center rounded-full border border-gray-300 group-aria-checked:border-brand-600 group-aria-checked:bg-brand-500"><span class="size-2 rounded-full bg-white opacity-0 group-aria-checked:opacity-100" /></span>
    </button>
    {
      rest.map((p) => {
        const t = tiles[p.key];
        return (
          <button role="radio" data-platform={p.key} aria-checked="false" class:list={[option, "flex items-center gap-4 p-4"]}>
            <span class:list={[tile, "size-12 flex-none", t?.bg ?? "bg-gray-100"]}>
              {t?.path ? (
                <svg viewBox="0 0 24 24" class="size-6" fill={t.fg} aria-hidden="true"><path d={t.path} /></svg>
              ) : t?.src ? (
                <img src={t.src} alt="" class="size-8 object-contain" />
              ) : (
                <Icon name="laptop" class="size-6 text-gray-700" />
              )}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-medium text-gray-900">{p.label}</span>
              <span class="block truncate text-[13px] text-gray-500">{p.note}</span>
            </span>
            <span class="grid size-5 flex-none place-items-center self-start rounded-full border border-gray-300 group-aria-checked:border-brand-600 group-aria-checked:bg-brand-500"><span class="size-2 rounded-full bg-white opacity-0 group-aria-checked:opacity-100" /></span>
          </button>
        );
      })
    }
  </div>

  {
    platforms.map((p, i) => (
      <div data-detail={p.key} hidden={i !== 0} class="msg-in mt-4 grid gap-4 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
        <div class="flex flex-col rounded-3xl bg-gray-100 p-8">
          <div class="flex gap-2">
            {agents.map((a) => (
              <span class="grid size-10 place-items-center rounded-xl bg-white">
                <Logo name={a} />
              </span>
            ))}
          </div>
          <h3 class="mt-6 text-2xl font-[550] tracking-[-0.02em]">Let your agent set it up</h3>
          <p class="mt-2 text-[15px] text-gray-500">It deploys the server, connects itself and sends you the pairing link.</p>
          <button class="copy-setup btn btn-primary mt-8 h-12 self-start px-6 text-base" data-prompt={setupPrompt(p.where)}>
            <Icon name="copy" class="size-4" /> <span>Copy setup prompt</span>
          </button>
        </div>

        <div class="rounded-3xl border border-gray-200 p-8">
          <h3 class="text-2xl font-[550] tracking-[-0.02em]">{p.key === "auto" ? "What your agent does" : "Or do it by hand"}</h3>
          <ol class="mt-6 flex flex-col gap-5">
            {(p.key === "auto" ? p.steps : [...p.steps, { text: "Open your server's URL. The app walks you through connecting your agent." }]).map((s, si) => (
              <li class="grid grid-cols-[1.75rem_minmax(0,1fr)] gap-3">
                <span class="grid size-7 place-items-center rounded-full bg-gray-100 text-[13px] font-medium text-gray-600">{si + 1}</span>
                <div class="min-w-0 pt-0.5">
                  <p class="text-[15px]">{s.text}</p>
                  {"code" in s && s.code && (
                    <pre class="mt-2 overflow-x-auto rounded-xl bg-gray-900 px-4 py-3 font-mono text-[13px] leading-6 text-gray-300">{s.code}</pre>
                  )}
                </div>
              </li>
            ))}
          </ol>
          {p.caveat && <p class="mt-6 rounded-xl bg-gray-100 px-4 py-3 text-sm text-gray-600">{p.caveat}</p>}
        </div>
      </div>
    ))
  }
</section>

<script>
  document.querySelectorAll<HTMLElement>(".get-started").forEach((root) => {
    const options = root.querySelectorAll<HTMLElement>("[data-platform]");
    const details = root.querySelectorAll<HTMLElement>("[data-detail]");
    options.forEach((o) =>
      o.addEventListener("click", () => {
        options.forEach((other) => other.setAttribute("aria-checked", String(other === o)));
        details.forEach((d) => (d.hidden = d.dataset.detail !== o.dataset.platform));
      }),
    );
    root.querySelectorAll<HTMLElement>(".copy-setup").forEach((button) => {
      const label = button.querySelector("span")!;
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(button.dataset.prompt!);
        label.textContent = "Copied, paste it into your agent";
        setTimeout(() => (label.textContent = "Copy setup prompt"), 2500);
      });
    });
  });
</script>
