---
import Page from "../layouts/Page.astro";
import Header from "../components/Header.astro";
import Icon from "../components/Icon.astro";
import Desktop from "../components/Desktop.astro";
import Phone from "../components/Phone.astro";
import Bird from "../components/Bird.astro";
import GetStarted from "../components/GetStarted.astro";
import AgentWall from "../components/AgentWall.astro";
import { siGithub } from "simple-icons";
import SetupPrompt from "../components/SetupPrompt.astro";
import Flock from "../components/Flock.astro";

const starPositions = Array.from({ length: 12 }, (_, i) => {
  const angle = (i * Math.PI) / 6;
  return [15 + 6 * Math.sin(angle), 10 - 6 * Math.cos(angle)];
});
const star = (cx: number, cy: number) =>
  Array.from({ length: 10 }, (_, i) => {
    const r = i % 2 ? 0.6 : 1.5;
    const a = (i * Math.PI) / 5;
    return `${i ? "L" : "M"}${(cx + r * Math.sin(a)).toFixed(2)} ${(cy - r * Math.cos(a)).toFixed(2)}`;
  }).join(" ") + "Z";


const card = "relative flex h-[280px] flex-col overflow-hidden rounded-3xl bg-gray-100 p-7";
const surface = "absolute top-20 right-0 bottom-0 left-7 rounded-tl-xl border-t border-l border-gray-200 bg-white p-5 text-[13px]";
---

<Page
  title="rply: agent notifications made easy"
  description="Push notifications from any AI agent, plus questions you can answer from your phone. Works with Claude Code, Codex, Cursor and anything with a shell. Free to start, open source and self-hostable."
>
  <div class="relative isolate mx-3 mt-3 overflow-hidden rounded-b-[28px] bg-linear-to-b from-transparent via-gray-100 via-35% to-[#eceefb]">
    <div class="absolute inset-0 -z-[2] [mask-image:linear-gradient(transparent,black_35%)]"><Flock subtle /></div>
    <Header />

  <section class="mx-auto max-w-6xl px-6 pt-6 text-center sm:pt-16">
    <h1 class="mx-auto max-w-3xl text-[clamp(2.75rem,6vw,4.5rem)] leading-[1] font-[550] tracking-[-0.04em]">
      Agent notifications made easy
    </h1>
    <p class="mx-auto mt-5 max-w-md text-lg text-gray-500">Push notifications from any agent, plus questions you can answer from your phone.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <SetupPrompt />
      <a href="https://app.rply.sh" class="btn btn-outline h-12 px-6 text-base">Go to app</a>
    </div>
    <ul class="mt-6 flex flex-wrap justify-center gap-x-7 gap-y-2 text-[15px] text-gray-600">
      <li class="flex items-center gap-1.5"><Icon name="check" class="size-4 text-gray-400" /> Free to start</li>
      <li><a href="https://github.com/joshuaKnauber/rply" class="flex items-center gap-1.5 hover:text-gray-900"><svg viewBox="0 0 24 24" class="size-4 text-gray-400" fill="currentColor" aria-hidden="true"><path d={siGithub.path} /></svg> Open source</a></li>
      <li><a href="/docs/self-hosting/overview/" class="flex items-center gap-1.5 hover:text-gray-900"><Icon name="server" class="size-4 text-gray-400" /> Self-hostable</a></li>
    </ul>

    <div class="stage relative mt-16 h-[680px] text-left">
      <div class="stage-content transition-opacity duration-500">
        <div class="absolute top-10 left-0 hidden w-[920px] lg:block">
          <Desktop />
        </div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 lg:right-0 lg:left-auto lg:translate-x-0">
          <Phone />
        </div>
      </div>
    </div>
  </section>
  </div>

  <section id="features" class="bento mx-auto mt-32 max-w-6xl scroll-mt-8 px-6">
    <h2 class="text-center text-[40px] leading-[1.05] font-[550] tracking-[-0.035em]">What your agent can do</h2>
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      <div class={card}>
        <h3 class="text-xl font-medium">Ask before it ships</h3>
        <div class={surface}>
          <p class="text-gray-500"><span class="font-medium text-gray-900">SEO bot</span> now</p>
          <p class="mt-1 text-sm">Publish 5 new pages?</p>
          <div class="mt-3 flex gap-2">
            <span class="btn btn-outline relative h-8 overflow-hidden">
              Publish
              <span class="approve-on btn-primary absolute inset-0 grid place-items-center">Publish</span>
              <span class="approve-tap absolute top-1/2 left-1/2 -mt-4 -ml-4 size-8 rounded-full border-2 border-white bg-black/20"></span>
            </span>
            <span class="approve-dim btn btn-outline h-8">Not yet</span>
          </div>
          <p class="approve-on mt-4 flex items-center gap-1.5 text-gray-500"><Icon name="check" class="size-3.5" /> Publishing</p>
        </div>
      </div>

      <div class={card}>
        <h3 class="text-xl font-medium">Live status</h3>
        <div class={surface}>
          <p class="flex justify-between text-gray-500">Migrating users <span class="text-xs">Pinned</span></p>
          <div class="mt-3 h-1.5 rounded-full bg-gray-200"><div class="track-bar h-full rounded-full bg-gray-800"></div></div>
          <ul class="mt-4 flex flex-col gap-2.5">
            {
              ["Copy rows", "Verify", "Switch over"].map((label, i) => (
                <li class="flex items-center gap-2.5">
                  <span class={`track-${i + 1} grid size-5 place-items-center rounded-full bg-gray-200 text-white`}>
                    <Icon name="check" class="size-3" />
                  </span>
                  {label}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class={card}>
        <h3 class="text-xl font-medium">Send it work</h3>
        <div class={surface}>
          <div class="ml-auto w-fit rounded-lg bg-gray-100 px-3 py-2.5 text-sm">Add a page for the Teams plan</div>
          <div class="relative mt-2 ml-auto h-5 w-28 text-right text-gray-500">
            {
              ["Sent", "Seen", "Working on it", "Done"].map((label, i) => (
                <span class="handoff-state absolute inset-0" style={`animation-delay:${-(6 - i * 1.5)}s`}>
                  {label}
                </span>
              ))
            }
          </div>
          <div class="handoff-reply mt-3 w-fit rounded-lg px-3 py-1">
            <p class="text-gray-500"><span class="font-medium text-gray-900">SEO bot</span> now</p>
            <p class="mt-1 text-sm">Done, it's live.</p>
          </div>
        </div>
      </div>

      <div class={card}>
        <h3 class="text-xl font-medium">Share keys safely</h3>
        <div class={surface}>
          <p class="flex items-center gap-2 font-medium text-gray-900"><Icon name="lock" class="size-3.5 text-gray-500" /> STRIPE_SECRET_KEY</p>
          <div class="mt-3 flex gap-2">
            <span class="flex h-8 flex-1 items-center overflow-hidden rounded-lg border border-gray-200 px-3">
              <span class="keys-dots overflow-hidden font-mono tracking-widest whitespace-nowrap text-gray-500">••••••••••••••••••</span>
            </span>
            <span class="btn btn-outline relative h-8 overflow-hidden">
              Send
              <span class="keys-on btn-primary absolute inset-0 grid place-items-center">Send</span>
            </span>
          </div>
          <div class="keys-file mt-5 flex w-fit items-center gap-2 rounded-lg bg-gray-900 px-3 py-2 font-mono text-xs text-gray-300">
            <Icon name="check" class="size-3.5 text-brand-300" /> written to .env
          </div>
        </div>
      </div>

      <div class={card}>
        <h3 class="text-xl font-medium">Push to your phone</h3>
        <div class="absolute inset-x-7 top-20 flex flex-col gap-2 text-[13px]">
          {
            [
              ["Deploy bot", "v2.4.1 is live"],
              ["Nightly backup", "Backup failed, retry?"],
              ["CI", "All tests passed"],
            ].map(([who, text], i) => (
              <div class="push flex gap-2.5 rounded-2xl bg-white/90 p-3 shadow-[0_6px_20px_-8px_rgb(0_0_0/0.2)]" style={`animation-delay:${i * 0.5}s`}>
                <span class="grid size-8 flex-none place-items-center rounded-lg border border-brand-600 bg-linear-to-b from-brand-400 to-brand-500 text-white">
                  <Bird class="size-4" />
                </span>
                <div class="leading-snug">
                  <p class="font-semibold text-gray-900">{who}</p>
                  <p class="text-gray-600">{text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class={card}>
        <h3 class="text-xl font-medium">Dashboards</h3>
        <div class={surface}>
          <p class="flex items-center gap-2 text-gray-500"><Icon name="app" class="size-3.5" /> Rankings</p>
          <div class="mt-3 flex h-20 items-end gap-2">
            {[38, 46, 41, 58, 64, 79, 92].map((h, i) => <span class="bar-grow flex-1 origin-bottom rounded-t-sm bg-brand-400" style={`height:${h}%;animation-delay:${i * 0.08}s`} />)}
          </div>
          <span class="btn btn-outline mt-4 h-8">Re-run audit</span>
        </div>
      </div>
    </div>
  </section>

  <GetStarted />

  <section id="integrations" class="mx-auto mt-32 max-w-6xl scroll-mt-8 px-6 text-center">
    <h2 class="text-[40px] leading-[1.05] font-[550] tracking-[-0.035em]">Works with your agent</h2>
    <p class="mt-3 text-lg text-gray-500">Anything that can run a shell command.</p>
    <div class="mt-14">
      <AgentWall />
    </div>
  </section>

  <section class="mx-auto mt-32 grid max-w-6xl items-center gap-10 px-6 md:grid-cols-2">
    <div>
      <h2 class="text-[40px] leading-[1.05] font-[550] tracking-[-0.035em]">Open source and self-hostable</h2>
      <p class="mt-4 max-w-md text-lg text-gray-500">
        The server, CLI and apps are on GitHub. Run the server yourself with one Docker container, or use app.rply.sh.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="https://github.com/joshuaKnauber/rply" class="btn btn-outline h-11 px-5 text-[15px]">
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d={siGithub.path} /></svg> View on GitHub
        </a>
        <a href="/docs/self-hosting/overview/" class="btn btn-outline h-11 px-5 text-[15px]"><Icon name="server" class="size-4" /> Self-hosting docs</a>
      </div>
    </div>
    <a href="https://github.com/joshuaKnauber/rply" class="block rounded-3xl bg-gray-100 p-4 sm:p-8">
      <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-[0_10px_30px_-16px_rgb(0_0_0/0.2)]">
        <p class="flex items-center gap-2 text-[15px]">
          <svg viewBox="0 0 24 24" class="size-5 text-gray-900" fill="currentColor" aria-hidden="true"><path d={siGithub.path} /></svg>
          <span class="hidden text-gray-500 sm:inline">joshuaKnauber /</span><span class="font-semibold text-gray-900">rply</span>
          <span class="ml-auto rounded-full border border-gray-200 px-2 py-0.5 text-xs text-gray-500">Public</span>
        </p>
        <p class="mt-3 text-[15px] text-gray-600">Agent notifications made easy. Server, CLI, web and mobile apps.</p>
        <div class="mt-5 flex flex-wrap gap-2 text-[13px]">
          {["TypeScript", "Docker", "SQLite", "Postgres"].map((tag) => <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-brand-700">{tag}</span>)}
        </div>
        <ul class="mt-5 divide-y divide-gray-200 border-t border-gray-200 text-sm">
          {
            [
              ["packages/server", "API, push and the web app"],
              ["packages/cli", "The rply command"],
              ["apps/web", "Inbox for your browser"],
              ["apps/mobile", "iOS and Android app"],
            ].map(([path, text]) => (
              <li class="flex items-center gap-3 py-2.5">
                <Icon name="folder" class="size-4 text-brand-400" />
                <span class="font-mono text-[13px] text-gray-900">{path}</span>
                <span class="ml-auto hidden text-gray-500 sm:inline">{text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </a>
  </section>

  <section class="mx-auto mt-32 max-w-6xl px-6 pb-24">
    <div class="relative isolate flex flex-col items-center overflow-hidden rounded-3xl bg-linear-to-b from-gray-100 to-[#eceefb] px-6 py-24 text-center">
      <Flock />
      <div class="pointer-events-none absolute inset-0 -z-[1] bg-[radial-gradient(ellipse_50%_45%_at_center,rgb(250_250_252/0.92)_45%,transparent)]"></div>
      <span class="cta-bird relative grid size-16 place-items-center rounded-2xl border border-brand-600 bg-linear-to-b from-brand-400 to-brand-500 text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.3),0_12px_30px_-10px_rgb(91_104_224/0.6)]">
        <Bird class="size-8" />
      </span>
      <h2 class="relative mt-6 text-[40px] leading-[1.05] font-[550] tracking-[-0.035em]">Get notified by your agents</h2>
      <p class="relative mt-3 text-gray-500">Free to start on app.rply.sh. Open source, so you can host it yourself.</p>
      <div class="relative mt-8 flex gap-3">
        <a href="#get-started" class="btn btn-primary">Get started</a>
        <a href="https://app.rply.sh" class="btn btn-outline">Go to app</a>
      </div>
    </div>
  </section>

  <footer class="border-t border-gray-200">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-6 px-6 py-8 text-sm text-gray-500">
      <span class="flex items-center gap-2 text-gray-900"><Bird class="size-4" /> rply.sh</span>
      <a href="/docs/start/introduction/" class="hover:text-gray-900">Docs</a>
      <a href="/docs/self-hosting/overview/" class="hover:text-gray-900">Self-host</a>
      <a href="https://www.npmjs.com/package/@rply/cli" class="hover:text-gray-900">npm</a>
      <a href="/llms.txt" class="hover:text-gray-900">llms.txt</a>
      <span class="flex w-full items-center gap-2 sm:ml-auto sm:w-auto">
        <svg viewBox="0 0 30 20" class="h-4 w-auto rounded-[2px]" role="img" aria-label="Flag of the European Union">
          <rect width="30" height="20" fill="#003399" />
          {starPositions.map(([x, y]) => <path d={star(x, y)} fill="#FFCC00" />)}
        </svg>
        Made in the EU
      </span>
    </div>
  </footer>
</Page>

<style>
  .cta-bird {
    animation: hover-bird 3.2s ease-in-out infinite;
  }
  @keyframes hover-bird {
    50% {
      transform: translateY(-6px) rotate(-3deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-bird {
      animation: none;
    }
  }
  .bento * {
    animation-duration: 6s;
    animation-iteration-count: infinite;
    animation-fill-mode: both;
  }
  .approve-on {
    animation-name: approve-on;
  }
  .approve-dim {
    animation-name: approve-dim;
  }
  .approve-tap {
    animation-name: tap;
  }
  @keyframes approve-on {
    0%,
    40% {
      opacity: 0;
    }
    44%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes approve-dim {
    0%,
    40%,
    100% {
      opacity: 1;
    }
    44%,
    92% {
      opacity: 0.4;
    }
  }
  @keyframes tap {
    0%,
    30% {
      opacity: 0;
      transform: scale(1.4);
    }
    36% {
      opacity: 1;
      transform: scale(1);
    }
    42% {
      opacity: 1;
      transform: scale(0.85);
    }
    48%,
    100% {
      opacity: 0;
    }
  }

  .track-bar {
    animation-name: track-bar;
  }
  @keyframes track-bar {
    0% {
      width: 0;
    }
    75%,
    95% {
      width: 100%;
    }
    100% {
      width: 0;
    }
  }
  .track-1 {
    animation-name: light-1;
  }
  .track-2 {
    animation-name: light-2;
  }
  .track-3 {
    animation-name: light-3;
  }
  @keyframes light-1 {
    0%,
    24%,
    100% {
      background: var(--color-gray-200);
    }
    26%,
    95% {
      background: var(--color-gray-800);
    }
  }
  @keyframes light-2 {
    0%,
    49%,
    100% {
      background: var(--color-gray-200);
    }
    51%,
    95% {
      background: var(--color-gray-800);
    }
  }
  @keyframes light-3 {
    0%,
    74%,
    100% {
      background: var(--color-gray-200);
    }
    76%,
    95% {
      background: var(--color-gray-800);
    }
  }

  .handoff-state {
    animation-name: slot;
  }
  @keyframes slot {
    0%,
    24% {
      opacity: 1;
    }
    25%,
    100% {
      opacity: 0;
    }
  }
  .handoff-reply {
    animation-name: reply;
  }
  @keyframes reply {
    0%,
    70% {
      opacity: 0;
      transform: translateY(6px);
    }
    76%,
    96% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  .keys-dots {
    animation-name: type;
  }
  @keyframes type {
    0% {
      width: 0;
    }
    35%,
    95% {
      width: 100%;
    }
    100% {
      width: 0;
    }
  }
  .keys-on {
    animation-name: keys-on;
  }
  @keyframes keys-on {
    0%,
    42% {
      opacity: 0;
    }
    46%,
    95% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  .keys-file {
    animation-name: keys-file;
  }
  @keyframes keys-file {
    0%,
    55% {
      opacity: 0;
      transform: translateY(6px);
    }
    60%,
    95% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  .push {
    animation-name: push;
  }
  @keyframes push {
    0% {
      opacity: 0;
      transform: translateY(-14px) scale(0.97);
    }
    8%,
    88% {
      opacity: 1;
      transform: none;
    }
    96%,
    100% {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .bar-grow {
    animation-name: grow;
  }
  @keyframes grow {
    0% {
      transform: scaleY(0);
    }
    15%,
    92% {
      transform: scaleY(1);
    }
    100% {
      transform: scaleY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bento * {
      animation-play-state: paused !important;
      animation-delay: -5.3s !important;
    }
    .bento .handoff-state {
      animation: none !important;
      opacity: 0;
    }
    .bento .handoff-state:last-child {
      opacity: 1;
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>(".stage")!;
  const content = stage.querySelector<HTMLElement>(".stage-content")!;
  const finger = stage.querySelector<HTMLElement>(".finger")!;
  const states = ["s-drafted", "s-ask", "opened", "answered", "done"];
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
  let answered: (() => void) | null = null;

  const setStatus = (text: string, width: string, instant = false) => {
    stage.querySelectorAll(".status-text").forEach((el) => (el.textContent = text));
    stage.querySelectorAll<HTMLElement>(".bar").forEach((bar) => {
      bar.style.transition = instant ? "none" : "";
      bar.style.width = width;
      if (instant) {
        void bar.offsetWidth;
        bar.style.transition = "";
      }
    });
  };

  const answer = () => {
    if (!stage.classList.contains("s-ask") || stage.classList.contains("answered")) return;
    stage.classList.add("opened", "answered");
    setStatus("0 of 5 live", "0", true);
    setStatus("0 of 5 live", "100%");
    for (let i = 1; i <= 5; i++) setTimeout(() => setStatus(i < 5 ? `${i} of 5 live` : "All 5 live", "100%"), i * 500);
    answered?.();
  };

  const tap = async (el: HTMLElement) => {
    const box = finger.parentElement!.getBoundingClientRect();
    const r = el.getBoundingClientRect();
    finger.style.left = `${r.left - box.left + r.width / 2}px`;
    finger.style.top = `${r.top - box.top + r.height / 2}px`;
    finger.animate(
      [
        { opacity: 0, transform: "scale(1.4)" },
        { opacity: 1, transform: "scale(1)", offset: 0.35 },
        { opacity: 1, transform: "scale(0.85)", offset: 0.65 },
        { opacity: 0, transform: "scale(1)" },
      ],
      { duration: 700, easing: "ease-out" },
    );
    await wait(350);
  };

  stage.querySelectorAll("[data-choice]").forEach((b) => b.addEventListener("click", answer));

  async function loop() {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      stage.classList.add("s-drafted", "s-ask", "opened");
      setStatus("Waiting for you", "0", true);
      return;
    }
    while (true) {
      stage.classList.remove(...states);
      setStatus("Drafting, 4 of 5", "80%", true);
      content.style.opacity = "1";
      await wait(1200);
      stage.classList.add("s-drafted");
      setStatus("Waiting for you", "0", true);
      await wait(1400);
      stage.classList.add("s-ask");
      const userAnswered = new Promise<void>((resolve) => (answered = resolve));
      await Promise.race([userAnswered, wait(3800)]);
      if (!stage.classList.contains("answered")) {
        await tap(stage.querySelector<HTMLElement>("[data-tap]")!);
        answer();
      }
      await wait(2800);
      stage.classList.add("done");
      await wait(5000);
      content.style.opacity = "0";
      await wait(500);
    }
  }
  loop();
</script>
