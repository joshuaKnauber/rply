---
import Bird from "../Bird.astro";
import Icon from "./Icon.astro";
---

<div class="phone relative w-[290px] rounded-[48px] bg-gray-900 p-[10px] shadow-[0_30px_60px_-20px_rgb(0_0_0/0.35)]">
  <div class="relative flex h-[600px] flex-col overflow-hidden rounded-[38px] bg-white text-[13px]">
    <div class="flex h-11 flex-none items-center justify-between px-7 pt-1 text-[13px] font-semibold text-gray-900">
      <span>9:41</span>
      <span class="absolute top-2.5 left-1/2 h-[26px] w-[86px] -translate-x-1/2 rounded-full bg-gray-900"></span>
      <span class="flex gap-1"><span class="h-2.5 w-4 rounded-[3px] border border-gray-900"></span></span>
    </div>

    <div class="notif pointer-events-none absolute inset-x-2.5 top-12 z-10 flex -translate-y-3 opacity-0 transition duration-500 ease-out [.s-ask:not(.opened)_&]:translate-y-0 [.s-ask:not(.opened)_&]:opacity-100 gap-2.5 rounded-2xl bg-white/85 p-3 shadow-[0_8px_24px_rgb(0_0_0/0.15)] ring-1 ring-black/5 backdrop-blur">
      <span class="grid size-8 flex-none place-items-center rounded-lg border border-brand-600 bg-linear-to-b from-brand-400 to-brand-500 text-white">
        <Bird class="size-4" />
      </span>
      <div class="min-w-0 leading-snug">
        <p class="flex justify-between font-semibold text-gray-900">SEO bot <span class="font-normal text-gray-500">now</span></p>
        <p class="text-gray-700">Publish them to acme.dev now?</p>
      </div>
    </div>

    <div class="flex flex-none items-center gap-2 border-b border-gray-200 px-4 pb-2.5">
      <span class="text-xl leading-none text-gray-500">‹</span>
      <div>
        <p class="font-medium text-gray-900">SEO bot</p>
        <p class="text-xs text-gray-500">acme.dev</p>
      </div>
    </div>

    <div class="mx-3 mt-3 flex-none rounded-lg bg-gray-100 px-3 py-2">
      <p class="flex justify-between"><span class="font-medium text-gray-900">Status</span><span class="status-text text-gray-500 tabular-nums">Waiting for you</span></p>
      <div class="mt-1.5 h-1 rounded-full bg-gray-200"><div class="bar h-full w-0 rounded-full bg-gray-800 transition-[width] duration-[2.5s] ease-out"></div></div>
    </div>

    <div class="flex flex-1 flex-col justify-end gap-0.5 overflow-hidden px-3 pt-2 pb-2 [mask-image:linear-gradient(transparent,black_20px)]">
      <div class="rounded-lg px-3 py-2">
        <p class="text-xs text-gray-500"><span class="font-medium text-gray-900">SEO bot</span> 9:12</p>
        <p class="mt-0.5">Keyword research for acme.dev is done. 14 new topics with more than 1k searches a month.</p>
        <div class="mt-2 flex items-center gap-2 rounded-lg border border-gray-200 px-2 py-1.5">
          <span class="rounded bg-gray-100 px-1 py-0.5 font-mono text-[9px] text-gray-600">CSV</span>
          <span class="text-gray-900">keywords.csv</span>
          <span class="ml-auto text-xs text-gray-500">4 KB</span>
        </div>
      </div>
      <div class="rounded-lg bg-gray-100 px-3 py-2">
        <p class="text-xs text-gray-500"><span class="font-medium text-gray-900">You</span> 9:20</p>
        <p class="mt-0.5">Nice. Draft pages for the top 5.</p>
      </div>
      <div class="msg-in hidden rounded-lg px-3 py-2 [.s-drafted_&]:block">
        <p class="text-xs text-gray-500"><span class="font-medium text-gray-900">SEO bot</span> 9:40</p>
        <p class="mt-0.5">Drafted all 5: /pricing, /pricing/teams, /compare, /faq and /security.</p>
      </div>
      <div class="msg-in hidden rounded-r-lg border-l-2 border-brand-600 px-3 py-2 [.answered_&]:border-transparent [.s-ask_&]:block">
        <p class="text-xs text-gray-500"><span class="font-medium text-gray-900">SEO bot</span> 9:41</p>
        <p class="mt-0.5">Publish them to acme.dev now?</p>
        <div class="mt-2 flex gap-1.5">
          <button class="btn btn-outline h-7 flex-1 justify-center px-2 text-[13px] [.answered_&]:btn-primary" data-choice data-tap>Publish</button>
          <button class="btn btn-outline h-7 flex-1 justify-center px-2 text-[13px] [.answered_&]:opacity-40">Not yet</button>
        </div>
      </div>
      <div class="msg-in hidden rounded-lg px-3 py-2 [.done_&]:block">
        <p class="text-xs text-gray-500"><span class="font-medium text-gray-900">SEO bot</span> 9:43</p>
        <p class="mt-0.5">All 5 pages are live. Indexing requested.</p>
      </div>
    </div>

    <div class="mx-3 mb-6 flex flex-none items-center justify-between rounded-xl bg-gray-100 px-3 py-2.5 text-gray-400">
      Message SEO bot <Icon name="arrow-up" class="size-4" />
    </div>
    <span class="finger pointer-events-none absolute z-20 -mt-4 -ml-4 size-8 rounded-full border-2 border-white bg-black/20 opacity-0"></span>
    <span class="absolute bottom-2 left-1/2 h-1 w-28 -translate-x-1/2 rounded-full bg-gray-900"></span>
  </div>
</div>
