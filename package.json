{
  "name": "rply-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node packages/server/src/index.ts",
    "dev:server": "npm run dev -w @rply/server",
    "dev:web": "npm run dev -w @rply/web",
    "build": "npm run build -w @rply/web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "rply": "node packages/cli/src/index.ts",
    "dev:mobile": "npm run start -w @rply/mobile",
    "dev:site": "npm run dev -w @rply/site",
    "build:site": "npm run build -w @rply/site"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "railway": "^3.13.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
