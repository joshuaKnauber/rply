---
import Icon from "../Icon.astro";

const options = [
  { value: "auto", label: "System", icon: "monitor" },
  { value: "light", label: "Light", icon: "sun" },
  { value: "dark", label: "Dark", icon: "moon" },
] as const;
---

<div class="theme-row">
  <rply-theme class="theme" role="radiogroup" aria-label="Theme">
    {
      options.map((o) => (
        <button role="radio" data-theme-value={o.value} aria-checked="false" title={o.label} aria-label={o.label}>
          <Icon name={o.icon} />
        </button>
      ))
    }
  </rply-theme>
  <a href="https://app.rply.sh" class="go-to-app">Go to app</a>
</div>

<style>
  .theme-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .theme {
    display: flex;
    gap: 0.125rem;
    padding: 0.1875rem;
    border-radius: 0.5rem;
    background: var(--rply-muted);
  }
  button {
    display: grid;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }
  button:hover {
    color: var(--sl-color-white);
  }
  button :global(svg) {
    width: 0.9375rem;
    height: 0.9375rem;
  }
  button[aria-checked="true"] {
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }
  .go-to-app {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding: 0 0.75rem;
    border: 1px solid var(--rply-brand-600);
    border-radius: 0.5rem;
    background: linear-gradient(to bottom, var(--rply-brand-400), var(--rply-brand));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.3), 0 1px 2px rgb(0 0 0 / 0.08);
    color: white;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .go-to-app:hover {
    filter: brightness(1.05);
  }
</style>

<script>
  type Theme = "auto" | "light" | "dark";
  const key = "starlight-theme";
  const load = (): Theme => {
    const stored = localStorage.getItem(key);
    return stored === "light" || stored === "dark" ? stored : "auto";
  };
  const system = () => (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");

  const apply = (theme: Theme) => {
    document.documentElement.dataset.theme = theme === "auto" ? system() : theme;
    localStorage.setItem(key, theme === "auto" ? "" : theme);
    document.querySelectorAll<HTMLElement>("rply-theme [data-theme-value]").forEach((b) =>
      b.setAttribute("aria-checked", String(b.dataset.themeValue === theme)),
    );
  };

  matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
    if (load() === "auto") apply("auto");
  });

  customElements.define(
    "rply-theme",
    class extends HTMLElement {
      connectedCallback() {
        apply(load());
        this.querySelectorAll<HTMLElement>("[data-theme-value]").forEach((b) =>
          b.addEventListener("click", () => apply(b.dataset.themeValue as Theme)),
        );
      }
    },
  );
</script>
