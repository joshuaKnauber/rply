---
import Page from "../layouts/Page.astro";
import Header from "../components/Header.astro";
import Icon from "../components/Icon.astro";
import Desktop from "../components/Desktop.astro";
import Phone from "../components/Phone.astro";
import Bird from "../components/Bird.astro";
import AgentWall from "../components/AgentWall.astro";
import { siGithub } from "simple-icons";
import SetupPrompt from "../components/SetupPrompt.astro";
import Flock from "../components/Flock.astro";
import Setup from "../components/Setup.astro";
import Demo from "../components/demo/Demo.astro";
import { birdPath } from "../components/bird.ts";

const starPositions = Array.from({ length: 12 }, (_, i) => {
  const angle = (i * Math.PI) / 6;
  return [15 + 6 * Math.sin(angle), 10 - 6 * Math.cos(angle)];
});
const star = (cx: number, cy: number) =>
  Array.from({ length: 10 }, (_, i) => {
    const r = i % 2 ? 0.6 : 1.5;
    const a = (i * Math.PI) / 5;
    return `${i ? "L" : "M"}${(cx + r * Math.sin(a)).toFixed(2)} ${(cy - r * Math.cos(a)).toFixed(2)}`;
  }).join(" ") + "Z";


const card = "flex flex-col rounded-3xl bg-gray-100 p-6 sm:p-8";
const title = "max-w-md text-lg leading-snug text-gray-500";
const visual = "relative mt-8 h-[230px] overflow-hidden rounded-2xl bg-linear-to-br";
const surface = "absolute inset-x-6 top-8 bottom-0 mx-auto max-w-sm rounded-t-xl bg-white p-5 text-sm shadow-[0_12px_32px_-12px_rgb(0_0_0/0.25)] sm:inset-x-10";
---

<Page
  title="rply: an inbox for agents that run without you"
  description="Your agents run on servers, around the clock. rply lets them reach you: updates, questions you answer from your phone, live dashboards and API keys that never pass through the agent. Works with Claude Code, Codex, OpenClaw and anything with a shell. Open source and self-hostable."
>
  <div class="relative isolate mx-3 mt-3 overflow-hidden rounded-b-[28px] bg-linear-to-b from-transparent via-gray-100 via-35% to-[#eceefb]">
    <div class="absolute inset-0 -z-[2] [mask-image:radial-gradient(ellipse_34%_26%_at_50%_24%,transparent_55%,black),linear-gradient(transparent,black_35%)] [mask-composite:intersect]"><Flock subtle /></div>
    <Header />

  <section class="mx-auto max-w-6xl px-6 pt-12 text-center sm:pt-16">
    <h1 class="mx-auto max-w-3xl text-[clamp(2.75rem,6vw,4.5rem)] leading-[1] font-[550] tracking-[-0.04em]">
      Retire your agent's Telegram bot
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-xl leading-relaxed text-gray-500">One open source inbox for agents that run without you. Updates on your phone, questions with buttons, live dashboards and API keys that never pass through the agent.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <SetupPrompt dark />
      <a href="https://app.rply.sh" class="btn btn-outline h-12 px-6 text-base">Go to app</a>
    </div>
    <ul class="mt-6 flex flex-wrap justify-center gap-x-7 gap-y-2 text-[15px] text-gray-600">
      <li class="flex items-center gap-1.5"><Icon name="check" class="size-4 text-gray-400" /> Free to start</li>
      <li><a href="https://github.com/joshuaKnauber/rply" class="flex items-center gap-1.5 hover:text-gray-900"><svg viewBox="0 0 24 24" class="size-4 text-gray-400" fill="currentColor" aria-hidden="true"><path d={siGithub.path} /></svg> Open source</a></li>
      <li><a href="/docs/self-hosting/overview/" class="flex items-center gap-1.5 hover:text-gray-900"><Icon name="server" class="size-4 text-gray-400" /> Self-hostable</a></li>
    </ul>

    <div class="stage group/stage relative mt-16 h-[680px] text-left">
      <button type="button" class="demo-open absolute inset-0 z-10 cursor-pointer rounded-3xl" aria-label="Try the interactive demo">
        <span class="pointer-events-none absolute inset-x-0 top-[40%] mx-auto h-72 max-w-2xl -translate-y-1/2 bg-[radial-gradient(closest-side,rgb(255_255_255/0.9),rgb(255_255_255/0.5)_55%,transparent)] opacity-70 transition-opacity duration-300 group-hover/stage:opacity-100"></span>
        <span class="demo-halo absolute top-[40%] left-1/2 flex h-14 -translate-x-1/2 -translate-y-1/2 items-center gap-3 rounded-full border border-brand-600 bg-linear-to-b from-brand-400 to-brand-500 py-2 pr-7 pl-2 text-base font-medium whitespace-nowrap text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.3),0_16px_40px_-12px_rgb(91_104_224/0.7)] transition-[filter] duration-200 group-hover/stage:brightness-110">
          <span class="grid size-10 place-items-center rounded-full bg-white text-brand-600"><Icon name="play" class="size-4 translate-x-px fill-current" /></span>
          Try the interactive demo
        </span>
      </button>
      <div class="stage-content transition-opacity duration-500">
        <div class="absolute top-10 left-0 hidden w-[920px] lg:block">
          <Desktop />
        </div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 lg:right-0 lg:left-auto lg:translate-x-0">
          <Phone />
        </div>
      </div>
    </div>
  </section>
  </div>

  <section id="features" class="bento mx-auto mt-32 max-w-6xl scroll-mt-8 px-6">
    <h2 class="text-center text-[40px] leading-[1.05] font-[550] tracking-[-0.035em]">One place to run your agents from</h2>
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      <div class={card}>
        <h3 class={title}><span class="font-medium text-gray-900">Ask before it ships.</span> Questions come with buttons, and the agent waits for your answer.</h3>
        <div class:list={[visual, "from-brand-100 to-brand-300/70"]}>
          <div class={surface}>
            <p class="flex items-center gap-2 text-gray-500"><span data-bird="exe-dev-seo" data-size="22" data-dot="off" class="block size-[22px] [&>svg]:size-full"></span><span class="font-medium text-gray-900">SEO bot</span> now</p>
            <p class="mt-2 text-[15px] text-gray-900">Publish 5 new pages to acme.dev?</p>
            <div class="mt-4 flex gap-2">
              <span class="btn btn-outline relative h-9 overflow-hidden px-4">
                Publish
                <span class="approve-on btn-primary absolute inset-0 grid place-items-center">Publish</span>
                <span class="approve-tap absolute top-1/2 left-1/2 -mt-4 -ml-4 size-8 rounded-full border-2 border-white bg-black/20"></span>
              </span>
              <span class="approve-dim btn btn-outline h-9 px-4">Not yet</span>
            </div>
            <p class="approve-on mt-5 flex items-center gap-1.5 text-gray-500"><Icon name="check" class="size-3.5" /> Publishing</p>
          </div>
        </div>
      </div>

      <div class={card}>
        <h3 class={title}><span class="font-medium text-gray-900">Updates on your phone.</span> Push notifications from every agent, in one inbox.</h3>
        <div class:list={[visual, "from-[#fdeadf] to-[#f5c9b5]"]}>
          <div class="absolute inset-x-6 top-8 mx-auto flex max-w-sm flex-col gap-2 text-sm sm:inset-x-10">
            {
              [
                ["SEO bot", "3 new pages in the top 10"],
                ["Support bot", "2 tickets need you"],
                ["Research bot", "Weekly report is ready"],
              ].map(([who, text], i) => (
                <div class="push flex gap-3 rounded-2xl bg-white/85 p-3 shadow-[0_8px_24px_-10px_rgb(0_0_0/0.25)] backdrop-blur" style={`animation-delay:${i * 0.5}s`}>
                  <span class="grid size-9 flex-none place-items-center rounded-[10px] border border-brand-600 bg-linear-to-b from-brand-400 to-brand-500 text-white">
                    <Bird class="size-4.5" />
                  </span>
                  <div class="leading-snug">
                    <p class="font-semibold text-gray-900">{who}</p>
                    <p class="text-gray-600">{text}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class={card}>
        <h3 class={title}><span class="font-medium text-gray-900">Share keys safely.</span> Keys go straight into .env, never through the agent.</h3>
        <div class:list={[visual, "from-[#e2f4ec] to-[#b8e2cf]"]}>
          <div class={surface}>
            <p class="flex items-center gap-2 text-[15px] font-medium text-gray-900"><Icon name="lock" class="size-4 text-gray-500" /> STRIPE_SECRET_KEY</p>
            <p class="mt-1 text-gray-500">Written to ~/app/.env</p>
            <div class="mt-4 flex gap-2">
              <span class="flex h-9 flex-1 items-center overflow-hidden rounded-lg border border-gray-200 px-3">
                <span class="keys-dots overflow-hidden font-mono tracking-widest whitespace-nowrap text-gray-500">••••••••••••••••••••••</span>
              </span>
              <span class="btn btn-outline relative h-9 overflow-hidden px-4">
                Send
                <span class="keys-on btn-primary absolute inset-0 grid place-items-center">Send</span>
              </span>
            </div>
            <div class="keys-file mt-5 flex w-fit items-center gap-2 rounded-lg bg-gray-900 px-3 py-2 font-mono text-xs text-gray-300">
              <Icon name="check" class="size-3.5 text-brand-300" /> STRIPE_SECRET_KEY written to .env
            </div>
          </div>
        </div>
      </div>

      <div class={card}>
        <h3 class={title}><span class="font-medium text-gray-900">Live status and dashboards.</span> Agents pin their progress and build small apps next to the chat.</h3>
        <div class:list={[visual, "from-[#e7e9ff] via-[#f1e6f6] to-[#fbe0e3]"]}>
          <div class={surface}>
            <p class="flex items-center gap-2 text-gray-500"><Icon name="app" class="size-3.5" /> Rankings</p>
            <div class="mt-4 flex h-20 items-end gap-2">
              {[38, 46, 41, 58, 64, 79, 92].map((h, i) => <span class="bar-grow flex-1 origin-bottom rounded-t-sm bg-brand-400" style={`height:${h}%;animation-delay:${i * 0.08}s`} />)}
            </div>
            <span class="btn btn-outline mt-5 h-9 px-4">Re-run audit</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Setup />

  <section id="integrations" class="mx-auto mt-32 max-w-6xl scroll-mt-8 px-6 text-center">
    <h2 class="text-[40px] leading-[1.05] font-[550] tracking-[-0.035em]">Works with any agent</h2>
    <p class="mt-3 text-lg text-gray-500">If it can run a shell command, it can use rply. Cron jobs and scripts too.</p>
    <div class="mt-14">
      <AgentWall />
    </div>
  </section>

  <section class="mx-auto mt-32 grid max-w-6xl items-center gap-10 px-6 md:grid-cols-2">
    <div>
      <h2 class="text-[40px] leading-[1.05] font-[550] tracking-[-0.035em]">Open source and self-hostable</h2>
      <p class="mt-4 max-w-md text-lg text-gray-500">
        The server, CLI and apps are on GitHub. Run the server yourself with one Docker container, or use app.rply.sh.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="https://github.com/joshuaKnauber/rply" class="btn btn-outline h-11 px-5 text-[15px]">
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d={siGithub.path} /></svg> View on GitHub
        </a>
        <a href="/docs/self-hosting/overview/" class="btn btn-outline h-11 px-5 text-[15px]"><Icon name="server" class="size-4" /> Self-hosting docs</a>
      </div>
    </div>
    <a href="https://github.com/joshuaKnauber/rply" class="block rounded-3xl bg-gray-100 p-4 sm:p-8">
      <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-[0_10px_30px_-16px_rgb(0_0_0/0.2)]">
        <p class="flex items-center gap-2 text-[15px]">
          <svg viewBox="0 0 24 24" class="size-5 text-gray-900" fill="currentColor" aria-hidden="true"><path d={siGithub.path} /></svg>
          <span class="hidden text-gray-500 sm:inline">joshuaKnauber /</span><span class="font-semibold text-gray-900">rply</span>
          <span class="ml-auto rounded-full border border-gray-200 px-2 py-0.5 text-xs text-gray-500">Public</span>
        </p>
        <p class="mt-3 text-[15px] text-gray-600">An inbox for agents that run without you. Server, CLI, web and mobile apps.</p>
        <div class="mt-5 flex flex-wrap gap-2 text-[13px]">
          {["TypeScript", "Docker", "SQLite", "Postgres"].map((tag) => <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-brand-700">{tag}</span>)}
        </div>
        <ul class="mt-5 divide-y divide-gray-200 border-t border-gray-200 text-sm">
          {
            [
              ["packages/server", "API, push and the web app"],
              ["packages/cli", "The rply command"],
              ["apps/web", "Inbox for your browser"],
              ["apps/mobile", "iOS and Android app"],
            ].map(([path, text]) => (
              <li class="flex items-center gap-3 py-2.5">
                <Icon name="folder" class="size-4 text-brand-400" />
                <span class="font-mono text-[13px] text-gray-900">{path}</span>
                <span class="ml-auto hidden text-gray-500 sm:inline">{text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </a>
  </section>

  <section class="mx-auto mt-32 max-w-6xl px-6 pb-24">
    <div class="relative isolate flex flex-col items-center overflow-hidden rounded-3xl bg-linear-to-b from-gray-100 to-[#eceefb] px-6 pt-24 text-center">
      <Flock />
      <div class="pointer-events-none absolute inset-0 -z-[1] bg-[radial-gradient(ellipse_50%_45%_at_center,rgb(250_250_252/0.92)_45%,transparent)]"></div>
      <h2 class="relative text-[40px] leading-[1.05] font-[550] tracking-[-0.035em]">Let your agents run. Stay in charge.</h2>
      <p class="relative mt-3 text-gray-500">Free to start on app.rply.sh. Open source, so you can host it yourself.</p>
      <div class="relative mt-8 flex gap-3">
        <a href="#get-started" class="btn btn-primary">Get started</a>
        <a href="https://app.rply.sh" class="btn btn-outline">Go to app</a>
      </div>
      <svg viewBox="0 0 442 417" class="cta-bird relative mt-14 -mb-[min(240px,40vw)] w-[min(520px,90%)] text-brand-300" fill="none" aria-hidden="true">
        <path d={birdPath.split("ZM")[0] + "Z"} fill="white" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" />
        <g class="cta-eye"><rect class="cta-lid" x="236" y="92" width="39" height="58" rx="19.5" fill="var(--color-brand-400)" /></g>
      </svg>
    </div>
  </section>

  <Demo />

  <footer class="border-t border-gray-200">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-6 px-6 py-8 text-sm text-gray-500">
      <span class="flex items-center gap-2 text-gray-900"><Bird class="size-4" /> rply.sh</span>
      <a href="/docs/start/introduction/" class="hover:text-gray-900">Docs</a>
      <a href="/docs/self-hosting/overview/" class="hover:text-gray-900">Self-host</a>
      <a href="https://www.npmjs.com/package/@rply/cli" class="hover:text-gray-900">npm</a>
      <a href="/llms.txt" class="hover:text-gray-900">llms.txt</a>
      <span class="flex w-full items-center gap-2 sm:ml-auto sm:w-auto">
        <svg viewBox="0 0 30 20" class="h-4 w-auto rounded-[2px]" role="img" aria-label="Flag of the European Union">
          <rect width="30" height="20" fill="#003399" />
          {starPositions.map(([x, y]) => <path d={star(x, y)} fill="#FFCC00" />)}
        </svg>
        Made in the EU
      </span>
    </div>
  </footer>
</Page>

<style>
  .demo-halo {
    animation: halo 2.4s ease-out infinite;
  }
  @keyframes halo {
    0% {
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.3),
        0 16px 40px -12px rgb(91 104 224 / 0.7),
        0 0 0 0 rgb(111 126 246 / 0.45);
    }
    70%,
    100% {
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.3),
        0 16px 40px -12px rgb(91 104 224 / 0.7),
        0 0 0 16px rgb(111 126 246 / 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-halo {
      animation: none;
    }
  }
  .cta-bird {
    animation: hover-bird 5s ease-in-out infinite;
  }
  .cta-eye {
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .cta-lid {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.08s ease-in;
  }
  .cta-lid.blink {
    transform: scaleY(0.12);
  }
  @keyframes hover-bird {
    50% {
      transform: translateY(-10px) rotate(-2deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-bird {
      animation: none;
    }
  }
  .bento * {
    animation-duration: 6s;
    animation-iteration-count: infinite;
    animation-fill-mode: both;
  }
  .approve-on {
    animation-name: approve-on;
  }
  .approve-dim {
    animation-name: approve-dim;
  }
  .approve-tap {
    animation-name: tap;
  }
  @keyframes approve-on {
    0%,
    40% {
      opacity: 0;
    }
    44%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes approve-dim {
    0%,
    40%,
    100% {
      opacity: 1;
    }
    44%,
    92% {
      opacity: 0.4;
    }
  }
  @keyframes tap {
    0%,
    30% {
      opacity: 0;
      transform: scale(1.4);
    }
    36% {
      opacity: 1;
      transform: scale(1);
    }
    42% {
      opacity: 1;
      transform: scale(0.85);
    }
    48%,
    100% {
      opacity: 0;
    }
  }

  .keys-dots {
    animation-name: type;
  }
  @keyframes type {
    0% {
      width: 0;
    }
    35%,
    95% {
      width: 100%;
    }
    100% {
      width: 0;
    }
  }
  .keys-on {
    animation-name: keys-on;
  }
  @keyframes keys-on {
    0%,
    42% {
      opacity: 0;
    }
    46%,
    95% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  .keys-file {
    animation-name: keys-file;
  }
  @keyframes keys-file {
    0%,
    55% {
      opacity: 0;
      transform: translateY(6px);
    }
    60%,
    95% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  .push {
    animation-name: push;
  }
  @keyframes push {
    0% {
      opacity: 0;
      transform: translateY(-14px) scale(0.97);
    }
    8%,
    88% {
      opacity: 1;
      transform: none;
    }
    96%,
    100% {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .bar-grow {
    animation-name: grow;
  }
  @keyframes grow {
    0% {
      transform: scaleY(0);
    }
    15%,
    92% {
      transform: scaleY(1);
    }
    100% {
      transform: scaleY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bento * {
      animation-play-state: paused !important;
      animation-delay: -5.3s !important;
    }
  }
</style>

<script>
  const ctaBird = document.querySelector<SVGSVGElement>(".cta-bird")!;
  const eye = ctaBird.querySelector<SVGGElement>(".cta-eye")!;
  const lid = ctaBird.querySelector<SVGRectElement>(".cta-lid")!;
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    addEventListener("pointermove", (e) => {
      const r = eye.getBoundingClientRect();
      const dx = e.clientX - (r.left + r.width / 2), dy = e.clientY - (r.top + r.height / 2), d = Math.hypot(dx, dy) || 1;
      const reach = Math.min(1, d / 300) * 16;
      eye.style.transform = `translate(${(dx / d) * reach}px, ${(dy / d) * reach}px)`;
    });
    const blink = () => {
      lid.classList.add("blink");
      setTimeout(() => lid.classList.remove("blink"), 120);
      setTimeout(blink, 2500 + Math.random() * 3500);
    };
    setTimeout(blink, 2000);
  }

  import { chirp, mountBirds, setMood } from "../components/agent-bird.ts";

  const stage = document.querySelector<HTMLElement>(".stage")!;
  const agent = "exe-dev-seo";
  mountBirds(stage);
  mountBirds(document.querySelector(".bento")!);
  const content = stage.querySelector<HTMLElement>(".stage-content")!;
  const finger = stage.querySelector<HTMLElement>(".finger")!;
  const states = ["s-drafted", "s-ask", "opened", "answered", "done"];
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
  let answered: (() => void) | null = null;

  const setStatus = (text: string, width: string, instant = false) => {
    stage.querySelectorAll(".status-text").forEach((el) => (el.textContent = text));
    stage.querySelectorAll<HTMLElement>(".bar").forEach((bar) => {
      bar.style.transition = instant ? "none" : "";
      bar.style.width = width;
      if (instant) {
        void bar.offsetWidth;
        bar.style.transition = "";
      }
    });
  };

  const answer = () => {
    if (!stage.classList.contains("s-ask") || stage.classList.contains("answered")) return;
    stage.classList.add("opened", "answered");
    setMood(agent, "working");
    setStatus("0 of 5 live", "0", true);
    setStatus("0 of 5 live", "100%");
    for (let i = 1; i <= 5; i++) setTimeout(() => setStatus(i < 5 ? `${i} of 5 live` : "All 5 live", "100%"), i * 500);
    answered?.();
  };

  const tap = async (el: HTMLElement) => {
    const box = finger.parentElement!.getBoundingClientRect();
    const r = el.getBoundingClientRect();
    finger.style.left = `${r.left - box.left + r.width / 2}px`;
    finger.style.top = `${r.top - box.top + r.height / 2}px`;
    finger.animate(
      [
        { opacity: 0, transform: "scale(1.4)" },
        { opacity: 1, transform: "scale(1)", offset: 0.35 },
        { opacity: 1, transform: "scale(0.85)", offset: 0.65 },
        { opacity: 0, transform: "scale(1)" },
      ],
      { duration: 700, easing: "ease-out" },
    );
    await wait(350);
  };

  stage.querySelectorAll("[data-choice]").forEach((b) => b.addEventListener("click", answer));

  async function loop() {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      stage.classList.add("s-drafted", "s-ask", "opened");
      setStatus("Waiting for you", "0", true);
      setMood(agent, "waiting");
      return;
    }
    while (true) {
      stage.classList.remove(...states);
      setMood(agent, "working");
      setStatus("Drafting, 4 of 5", "80%", true);
      content.style.opacity = "1";
      await wait(1200);
      stage.classList.add("s-drafted");
      chirp(agent);
      setMood(agent, "idle");
      setStatus("Waiting for you", "0", true);
      await wait(1400);
      stage.classList.add("s-ask");
      chirp(agent);
      setMood(agent, "waiting");
      const userAnswered = new Promise<void>((resolve) => (answered = resolve));
      await Promise.race([userAnswered, wait(3800)]);
      if (!stage.classList.contains("answered")) {
        await tap(stage.querySelector<HTMLElement>("[data-tap]")!);
        answer();
      }
      await wait(2800);
      stage.classList.add("done");
      chirp(agent);
      setMood(agent, "done");
      await wait(3000);
      setMood(agent, "idle");
      await wait(2000);
      content.style.opacity = "0";
      await wait(500);
    }
  }
  loop();
</script>
