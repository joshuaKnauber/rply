---
import "@fontsource-variable/inter/opsz.css";
import "@fontsource-variable/geist-mono";
import "../styles/lab.css";

interface Props {
  title: string;
  dark?: boolean;
}
const { title, dark } = Astro.props;
const variants = [
  { href: "/lab/a/", label: "A · The app" },
  { href: "/lab/a3/", label: "A3 · Use cases" },
  { href: "/lab/a4/", label: "A4 · Visual" },
  { href: "/lab/b/", label: "B · Two ends" },
  { href: "/lab/c/", label: "C · Your turn" },
];
const path = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class:list={[dark && "bg-gray-950"]}>
    <slot />
    <nav class="fixed bottom-4 left-1/2 z-50 flex -translate-x-1/2 gap-1 rounded-xl bg-gray-900/90 p-1 text-xs text-gray-300 shadow-lg backdrop-blur">
      {
        variants.map((v) => (
          <a href={v.href} class:list={["rounded-lg px-3 py-1.5", path === v.href || path === v.href.slice(0, -1) ? "bg-white/15 text-white" : "hover:text-white"]}>
            {v.label}
          </a>
        ))
      }
    </nav>
  </body>
</html>
