---
import Lab from "../../layouts/Lab.astro";
import Header from "../../components/lab/Header.astro";
import Icon from "../../components/lab/Icon.astro";
import Bird from "../../components/Bird.astro";

const channels = [
  { name: "SEO bot", preview: "Publish 5 new pages for acme.dev?", time: "9:41", active: true, waiting: true },
  { name: "Deploy bot", preview: "Deployed v2.4.1 to production", time: "9:12" },
  { name: "Nightly backup", preview: "Backup finished, 2.1 GB", time: "3:00" },
  { name: "Inbox triage", preview: "Archived 38 newsletters", time: "Mon" },
];

const features = [
  {
    title: "Ask and wait",
    text: "Your agent asks a question and blocks until you answer. Choices, forms, or a plain text reply.",
    command: `rply ask "Publish 5 pages?" --choices Publish,"Not yet" --wait`,
  },
  {
    title: "A status that stays on top",
    text: "Pinned messages update in place, so the current state is always one glance away.",
    command: `rply status patch --patch '{"id":"live","value":42}'`,
  },
  {
    title: "Send it work any time",
    text: "Write to the agent whenever you think of something. It picks it up from its inbox.",
    command: "rply inbox --wait",
  },
  {
    title: "Secrets that skip the chat",
    text: "Paste an API key in the app. It's encrypted on your device and written straight to the agent's .env.",
    command: "rply secret request OPENAI_API_KEY --to .env",
  },
];

const runsOn = ["Claude Code", "Codex", "Cursor", "Gemini CLI", "OpenClaw", "cron", "GitHub Actions", "git hooks"];
---

<Lab title="rply · direction A">
  <Header />

  <section class="overflow-hidden">
    <div class="mx-auto max-w-6xl px-6 pt-20">
      <h1 class="max-w-3xl text-[56px] leading-[1.02] font-semibold tracking-[-0.035em]">One inbox for all your agents</h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-gray-500">
        Your agents send updates, ask questions and wait for your answer. You reply from your laptop or your phone. Any
        agent that can run a shell command can use it.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/docs/start/quickstart/" class="btn btn-primary">Get started</a>
        <button class="copy btn btn-outline font-mono font-normal text-gray-600" data-copy="npx @rply/cli init https://rply.sh">
          <span class="text-gray-400">$</span> npx @rply/cli init
          <Icon name="copy" class="size-3.5 text-gray-400" />
        </button>
      </div>

      <div class="app relative mt-16 -mr-40 h-[560px] overflow-hidden rounded-t-xl border border-b-0 border-gray-200 bg-white shadow-[0_24px_60px_-30px_rgb(0_0_0/0.25)] lg:mr-0">
        <div class="grid h-full grid-cols-[248px_1fr_272px] text-[13px]">
          <aside class="flex flex-col border-r border-gray-200 bg-gray-100">
            <div class="flex h-12 items-center gap-2 border-b border-gray-200 px-4 font-medium text-gray-900">
              <Bird class="size-4" /> rply.sh
              <span class="ml-auto flex gap-3 text-gray-500"><Icon name="bell" /><Icon name="plus" /></span>
            </div>
            <p class="px-4 pt-4 pb-2 text-gray-500">4 channels</p>
            {
              channels.map((c) => (
                <div class:list={["px-4 py-2.5", c.active && "bg-gray-150"]}>
                  <div class="flex items-center gap-1.5">
                    <span class="font-medium text-gray-900">{c.name}</span>
                    {c.waiting && <span class="waiting size-1.5 rounded-full bg-brand-600" />}
                    <span class="ml-auto text-xs text-gray-500 tabular-nums">{c.time}</span>
                  </div>
                  <p class="mt-0.5 truncate text-gray-500">{c.preview}</p>
                  {c.active && (
                    <p class="mt-2 -mb-0.5 flex items-center gap-2 pl-2 text-gray-500">
                      <Icon name="app" class="size-3.5" /> Rankings
                    </p>
                  )}
                </div>
              ))
            }
          </aside>

          <main class="flex min-w-0 flex-col">
            <div class="flex h-12 flex-none items-center border-b border-gray-200 px-5 text-[15px] font-medium text-gray-900">
              SEO bot
              <Icon name="ellipsis" class="ml-auto size-4 text-gray-500" />
            </div>
            <div class="flex flex-1 flex-col justify-end gap-1 overflow-hidden px-5 pb-3">
              <div class="rounded-lg px-3 py-2.5">
                <p class="text-gray-500"><span class="font-medium text-gray-900">SEO bot</span> <span class="tabular-nums">9:12</span></p>
                <p class="mt-1 text-sm">Keyword research for acme.dev is done. 14 new topics with more than 1k searches a month.</p>
                <div class="mt-2 flex w-72 items-center gap-3 rounded-lg border border-gray-200 px-2.5 py-2">
                  <span class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-[10px] text-gray-600">CSV</span>
                  <span class="text-gray-900">keywords.csv</span>
                  <span class="ml-auto text-xs text-gray-500">4 KB</span>
                </div>
              </div>
              <div class="rounded-lg bg-gray-100 px-3 py-2.5">
                <p class="text-gray-500"><span class="font-medium text-gray-900">You</span> <span class="tabular-nums">9:20</span></p>
                <p class="mt-1 text-sm">Nice. Draft pages for the top 5.</p>
              </div>
              <div class="question rounded-r-lg border-l-2 border-brand-600 px-3 py-2.5 [.answered_&]:border-transparent">
                <p class="text-gray-500"><span class="font-medium text-gray-900">SEO bot</span> <span class="tabular-nums">9:41</span></p>
                <p class="mt-1 text-sm">I drafted 5 new pages for acme.dev. Publish them now?</p>
                <div class="mt-2.5 flex gap-2">
                  <button class="choice btn btn-outline h-8 [.answered_&]:btn-primary" data-choice>Publish</button>
                  <button class="btn btn-outline h-8 [.answered_&]:opacity-40">Not yet</button>
                </div>
              </div>
              <div class="hidden rounded-lg px-3 py-2.5 [.answered_&]:block">
                <p class="text-gray-500"><span class="font-medium text-gray-900">SEO bot</span> <span class="tabular-nums">9:42</span></p>
                <p class="mt-1 text-sm">Publishing. I'll update the status as each page goes live.</p>
              </div>
            </div>
            <div class="mx-5 mb-5 rounded-xl bg-gray-100 px-4 pt-3 pb-2 text-sm text-gray-400">
              Message SEO bot
              <div class="mt-3 flex justify-between"><Icon name="plus" /><Icon name="arrow-up" /></div>
            </div>
          </main>

          <aside class="border-l border-gray-200 px-5">
            <div class="flex h-12 items-center text-gray-500">Pinned</div>
            <div class="divide-y divide-gray-200">
              <div class="pb-5">
                <p class="text-gray-500">Status <span class="float-right text-xs tabular-nums">9:42</span></p>
                <dl class="mt-3 grid grid-cols-3 gap-2">
                  <div><dt class="text-xs text-gray-500">Live</dt><dd class="text-lg font-semibold text-gray-900 tabular-nums">42</dd></div>
                  <div><dt class="text-xs text-gray-500">Indexed</dt><dd class="text-lg font-semibold text-gray-900 tabular-nums">38</dd></div>
                  <div><dt class="text-xs text-gray-500">Clicks</dt><dd class="text-lg font-semibold text-gray-900 tabular-nums">+38%</dd></div>
                </dl>
                <p class="mt-4 flex justify-between"><span>Published</span><span class="text-gray-500 tabular-nums">0 of 5</span></p>
                <div class="mt-1.5 h-1 rounded-full bg-gray-200"><div class="bar h-full w-0 rounded-full bg-gray-800 transition-[width] duration-1000"></div></div>
              </div>
              <div class="py-5">
                <p class="text-gray-500">Agents</p>
                <p class="mt-2 flex items-center gap-2"><Icon name="bot" class="size-4 text-gray-500" /> exe-dev-seo <span class="ml-auto text-xs text-gray-500">Active now</span></p>
              </div>
            </div>
          </aside>
        </div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-linear-to-t from-white"></div>
      </div>
    </div>
  </section>

  <section class="border-t border-gray-200">
    <div class="mx-auto grid max-w-6xl gap-px bg-gray-200 sm:grid-cols-2">
      {
        features.map((f) => (
          <div class="bg-white px-6 py-12 sm:px-10">
            <h3 class="text-lg font-medium">{f.title}</h3>
            <p class="mt-2 max-w-md text-[15px] leading-relaxed text-gray-500">{f.text}</p>
            <p class="mt-6 truncate font-mono text-[13px] text-gray-600">
              <span class="text-gray-400">$</span> {f.command}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-gray-200 bg-gray-100">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 py-20 md:grid-cols-2">
      <div>
        <h2 class="text-[32px] leading-tight font-semibold tracking-[-0.03em]">Works with what you already run</h2>
        <p class="mt-4 max-w-md text-[15px] leading-relaxed text-gray-500">
          rply is a CLI, so there's no SDK and no MCP setup. If it can run a shell command, it can reach you.
        </p>
      </div>
      <ul class="grid grid-cols-2 content-start gap-x-8 text-[15px]">
        {runsOn.map((name) => <li class="border-b border-gray-200 py-2.5">{name}</li>)}
      </ul>
    </div>
  </section>

  <section class="border-t border-gray-200">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-20 md:grid-cols-2">
      <div>
        <h2 class="text-[32px] leading-tight font-semibold tracking-[-0.03em]">Open source, and yours to run</h2>
        <p class="mt-4 max-w-md text-[15px] leading-relaxed text-gray-500">
          One Docker image with SQLite. Put it on Railway, a VPS, or next to your agent on exe.dev. Push notifications
          still work.
        </p>
        <div class="mt-6 flex gap-3">
          <a href="/self-host/" class="btn btn-primary">Self-host rply</a>
          <a href="https://github.com/joshuaKnauber/rply" class="btn btn-outline">View on GitHub</a>
        </div>
      </div>
      <pre class="overflow-x-auto rounded-xl bg-gray-100 p-5 font-mono text-[13px] leading-6 text-gray-700"><span class="text-gray-400">$</span> npx @rply/cli init https://rply.example.com
<span class="text-gray-500">Channel "SEO bot" created. Open the link to pair:</span>
<span class="text-brand-600">https://rply.example.com/pair?c=K7QX-M2PD</span>
<span class="text-gray-400">$</span> rply send "Hello from the agent"</pre>
    </div>
  </section>

  <footer class="border-t border-gray-200">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-6 px-6 py-8 pb-20 text-sm text-gray-500">
      <span class="flex items-center gap-2 text-gray-900"><Bird class="size-4" /> rply.sh</span>
      <a href="/docs/start/introduction/" class="hover:text-gray-900">Docs</a>
      <a href="/self-host/" class="hover:text-gray-900">Self-host</a>
      <a href="/compare/" class="hover:text-gray-900">Compare</a>
      <a href="https://www.npmjs.com/package/@rply/cli" class="hover:text-gray-900">npm</a>
      <span class="ml-auto">Free and open source</span>
    </div>
  </footer>
</Lab>

<script>
  const app = document.querySelector<HTMLElement>(".app")!;
  app.querySelector("[data-choice]")!.addEventListener("click", () => {
    app.classList.add("answered");
    app.querySelector(".waiting")?.remove();
    app.querySelector<HTMLElement>(".bar")!.style.width = "100%";
  });
  document.querySelectorAll<HTMLElement>("[data-copy]").forEach((el) =>
    el.addEventListener("click", () => navigator.clipboard.writeText(el.dataset.copy!)),
  );
</script>
