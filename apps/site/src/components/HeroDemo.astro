---
const msg = "grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-450 *:min-h-0 *:overflow-hidden";
const bubble = "mt-2 max-w-[85%] rounded-[14px] bg-neutral-100 px-2.5 py-2";
const choice =
  "flex-1 rounded-lg border border-neutral-300 bg-white py-[5px] text-center transition-[background-color,color,opacity] duration-200 [&.pressed]:border-neutral-900 [&.pressed]:bg-neutral-900 [&.pressed]:text-white in-[.answered]:not-[.pressed]:opacity-35";
---

<div
  class="demo relative size-full overflow-hidden text-left text-[12px] leading-[1.4] text-neutral-900 not-italic transition-opacity duration-500 [&.fading]:opacity-0 [&.instant_*]:transition-none!"
  style="--progress: 0%"
  role="img"
  aria-label="An agent asks to publish pages, you answer from a notification, and it reports progress and a traffic chart"
>
  <div class="absolute top-2 left-1/2 z-3 h-5 w-[72px] -translate-x-1/2 rounded-[10px] bg-black"></div>

  <div
    class="absolute inset-0 px-2.5 pt-14 text-white transition-[opacity,scale] duration-450 in-[.opened]:scale-108 in-[.opened]:opacity-0"
  >
    <svg class="absolute inset-0 size-full" viewBox="0 0 280 582" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="sky" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#1aa3ec" />
          <stop offset="1" stop-color="#0c6fc4" />
        </linearGradient>
        <linearGradient id="band0" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#f4f8ff" />
          <stop offset="1" stop-color="#d6e6fb" />
        </linearGradient>
        <linearGradient id="band1" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffc02e" />
          <stop offset="1" stop-color="#ffa216" />
        </linearGradient>
        <linearGradient id="band2" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ff7440" />
          <stop offset="1" stop-color="#ff4b3c" />
        </linearGradient>
        <linearGradient id="band3" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ff3358" />
          <stop offset="1" stop-color="#e81f5c" />
        </linearGradient>
        <linearGradient id="band4" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#d81f7c" />
          <stop offset="1" stop-color="#a91d80" />
        </linearGradient>
        <linearGradient id="band5" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#702c90" />
          <stop offset="1" stop-color="#40307f" />
        </linearGradient>
        <filter id="fold" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="-3" dy="-4" stdDeviation="9" flood-color="#2a0a2a" flood-opacity="0.28" />
        </filter>
      </defs>
      <rect width="280" height="582" fill="url(#sky)" />
      <path d="M95,-20 C130,50 190,95 300,125 L300,700 L-20,700 L-20,-20 Z" fill="url(#band0)" filter="url(#fold)" />
      <path d="M70,-20 C115,80 190,140 300,170 L300,700 L-20,700 L-20,-20 Z" fill="url(#band1)" filter="url(#fold)" />
      <path d="M35,-20 C95,120 180,200 300,250 L300,700 L-20,700 L-20,-20 Z" fill="url(#band2)" filter="url(#fold)" />
      <path d="M-20,90 C70,200 160,310 300,390 L300,700 L-20,700 L-20,-20 Z" fill="url(#band3)" filter="url(#fold)" />
      <path d="M-20,260 C70,350 170,450 300,540 L300,700 L-20,700 L-20,-20 Z" fill="url(#band4)" filter="url(#fold)" />
      <path d="M-20,430 C60,480 130,560 200,620 L300,700 L-20,700 L-20,-20 Z" fill="url(#band5)" filter="url(#fold)" />
    </svg>
    <div class="relative mb-7 flex flex-col items-center">
      <span class="text-[13px] font-medium">Monday, October 12</span>
      <span class="text-[64px] leading-[1.1] font-semibold">9:41</span>
    </div>
    <div
      class="notif relative flex -translate-y-6 gap-2 rounded-2xl bg-white/80 p-2.5 text-neutral-900 opacity-0 backdrop-blur-md transition-[opacity,translate,scale] duration-400 ease-[cubic-bezier(0.2,0.9,0.3,1.2)] in-[.notified]:translate-y-0 in-[.notified]:opacity-100 [&.pressed]:scale-97"
    >
      <div
        class="grid size-[30px] flex-none place-items-center rounded-lg bg-linear-to-b from-accent-400 to-accent-500 font-bold text-white"
      >
        r
      </div>
      <div class="flex-1">
        <div class="flex justify-between"><strong>SEO bot</strong><span class="text-neutral-500">now</span></div>
        <p>Publish 5 new pages for acme.dev?</p>
      </div>
    </div>
  </div>

  <div
    class="absolute inset-0 flex scale-92 flex-col bg-white opacity-0 transition-[opacity,scale] duration-450 in-[.opened]:scale-100 in-[.opened]:opacity-100"
  >
    <header class="flex items-center gap-2 border-b border-neutral-200 px-3 pt-9 pb-2">
      <span class="text-[22px] leading-none text-neutral-500">‹</span>
      <div class="flex flex-col">
        <strong>SEO bot</strong>
        <span class="text-[11px] text-neutral-500">acme.dev</span>
      </div>
    </header>
    <div class="mx-2.5 mt-2 rounded-xl border border-neutral-200 bg-neutral-50 px-2.5 py-2">
      <div class="flex gap-1.5">
        <span>📌</span>
        <strong>Status</strong>
        <span class="ml-auto text-neutral-500" data-pin-text></span>
      </div>
      <div
        class="h-1 max-h-0 overflow-hidden rounded-xs bg-neutral-200 opacity-0 transition-all duration-300 in-[.answered]:mt-1.5 in-[.answered]:max-h-1 in-[.answered]:opacity-100"
      >
        <div class="h-full w-(--progress) bg-accent-500 transition-[width] duration-400"></div>
      </div>
    </div>
    <div class="flex min-h-0 flex-1 flex-col justify-end overflow-hidden px-2.5 pb-2 [mask-image:linear-gradient(transparent,black_24px)]">
      <div>
        <div>
          <div class:list={[bubble, "ml-auto bg-neutral-900 text-white"]}>
            <p>Can you add pages for the new pricing plans?</p>
          </div>
          <div class={bubble}><p>Sure, drafting them now.</p></div>
        </div>
      </div>
      <div>
        <div>
          <div class={bubble}>
            <p>I drafted 5 new pages for acme.dev. Publish them now?</p>
            <div class="mt-2 flex gap-1.5">
              <span class={choice} data-choice>Publish</span>
              <span class={choice}>Not yet</span>
            </div>
            <p
              class="max-h-0 text-[11px] text-neutral-500 opacity-0 transition-all duration-300 in-[.answered]:mt-1.5 in-[.answered]:max-h-4 in-[.answered]:opacity-100"
            >
              Answered
            </p>
          </div>
        </div>
      </div>
      <div class:list={[msg, "in-[.publishing]:grid-rows-[1fr] in-[.publishing]:opacity-100"]}>
        <div><div class={bubble}><p>On it. Publishing 5 pages…</p></div></div>
      </div>
      <div class:list={[msg, "in-[.live]:grid-rows-[1fr] in-[.live]:opacity-100"]}>
        <div><div class={bubble}><p>All 5 pages are live. Indexing requested.</p></div></div>
      </div>
      <div class:list={[msg, "in-[.charted]:grid-rows-[1fr] in-[.charted]:opacity-100"]}>
        <div>
          <div class={bubble}>
            <div class="flex justify-between gap-3">
              <strong>Clicks this week</strong><span class="font-semibold text-green-600">+38%</span>
            </div>
            <div class="mt-2 flex h-16 w-[170px] items-end gap-1">
              {
                [38, 46, 41, 58, 64, 79, 92].map((h, i) => (
                  <span
                    class="flex-1 origin-bottom scale-y-0 rounded-t-[3px] bg-accent-500 transition-transform duration-600 in-[.charted]:scale-y-100"
                    style={`height: ${h}%; transition-delay: ${i * 70 + 300}ms`}
                  />
                ))
              }
            </div>
            <div class="mt-1 flex w-[170px] gap-1 text-[9px] text-neutral-400">
              {["M", "T", "W", "T", "F", "S", "S"].map((d) => <span class="flex-1 text-center">{d}</span>)}
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="mx-2.5 mb-[22px] rounded-[18px] border border-neutral-200 px-3 py-2 text-neutral-400">Message SEO bot</div>
  </div>

  <div
    class="finger pointer-events-none absolute z-4 -mt-[17px] -ml-[17px] size-[34px] rounded-full border-2 border-white bg-black/25 opacity-0"
  >
  </div>
</div>

<script>
  const states = ["notified", "opened", "answered", "publishing", "live", "charted"];
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  function setup(demo: HTMLElement) {
    const $ = (selector: string) => demo.querySelector<HTMLElement>(selector)!;
    const finger = $(".finger");

    const setPin = (text: string, progress: number) => {
      $("[data-pin-text]").textContent = text;
      demo.style.setProperty("--progress", `${progress}%`);
    };

    const reset = () => {
      demo.classList.add("instant");
      demo.classList.remove(...states);
      demo.querySelectorAll(".pressed").forEach((el) => el.classList.remove("pressed"));
      setPin("Waiting for your answer", 0);
      void demo.offsetWidth;
      demo.classList.remove("instant");
    };

    const tap = async (el: HTMLElement) => {
      const d = demo.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      finger.style.left = `${r.left - d.left + r.width / 2}px`;
      finger.style.top = `${r.top - d.top + r.height / 2}px`;
      finger.classList.remove("animate-tap");
      void finger.offsetWidth;
      finger.classList.add("animate-tap");
      await wait(300);
      el.classList.add("pressed");
      await wait(300);
    };

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      demo.classList.add(...states);
      $("[data-choice]").classList.add("pressed");
      setPin("5 pages live", 100);
      return;
    }

    (async () => {
      while (true) {
        reset();
        await wait(800);
        demo.classList.add("notified");
        await wait(1600);
        await tap($(".notif"));
        demo.classList.add("opened");
        await wait(1500);
        await tap($("[data-choice]"));
        demo.classList.add("answered");
        setPin("Publishing 0/5", 0);
        await wait(500);
        demo.classList.add("publishing");
        for (let i = 1; i <= 5; i++) {
          await wait(600);
          setPin(`Publishing ${i}/5`, i * 20);
        }
        await wait(400);
        setPin("5 pages live", 100);
        demo.classList.add("live");
        await wait(1400);
        demo.classList.add("charted");
        await wait(5000);
        demo.classList.add("fading");
        await wait(500);
        reset();
        demo.classList.remove("fading");
      }
    })();
  }

  document.querySelectorAll<HTMLElement>(".demo").forEach(setup);
</script>
