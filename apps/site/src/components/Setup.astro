---
import Icon from "./Icon.astro";
import Logo, { type LogoName } from "./Logo.astro";
import { siTelegram } from "simple-icons";
import { hosted, selfHosted, promptFor, hermesPrompt } from "./setup.ts";
import type { IconName } from "./icons.ts";
import { tagged } from "./track.ts";

const agents: { key: LogoName; label: string }[] = [
  { key: "claude", label: "Claude Code" },
  { key: "codex", label: "Codex" },
  { key: "hermes", label: "Hermes" },
  { key: "openclaw", label: "OpenClaw" },
  { key: "cursor", label: "Cursor" },
  { key: "gemini", label: "Gemini CLI" },
  { key: "cron", label: "A cron job" },
];

const replaces: { key: string; icon: IconName | "telegram"; label: string; title: string; text: string }[] = [
  { key: "telegram", icon: "telegram", label: "Telegram bot", title: "Push to your phone.", text: "Replies go straight back to the agent, no bot to host." },
  { key: "site", icon: "monitor", label: "Status website", title: "A pinned status page.", text: "Live progress at the top of the chat, not on a site the agent hosts." },
  { key: "ask", icon: "ellipsis", label: "Yes or no in chat", title: "Questions with buttons.", text: "The agent waits for your tap, nothing to parse." },
  { key: "keys", icon: "lock", label: "Pasted API keys", title: "Keys straight into .env.", text: "Encrypted on your phone, never in the agent's context." },
  { key: "ssh", icon: "terminal", label: "SSH sessions", title: "Tasks from anywhere.", text: "Message it from your phone and see when it starts and finishes." },
];

const servers = [hosted, ...selfHosted];
const hosts: Record<string, string> = {
  hosted: "app.rply.sh",
  exe: "rply.exe.xyz",
  railway: "rply.up.railway.app",
  fly: "rply.fly.dev",
  render: "rply.onrender.com",
  vps: "rply.example.com",
  local: "localhost:8080",
};
const serverNote = (p: typeof hosted) => (p === hosted ? "Free to start, nothing to deploy." : p.caveat ?? `${p.note}. One Docker container with SQLite.`);

const chip =
  "inline-flex h-9 items-center gap-2 rounded-full border border-gray-200 bg-white px-3.5 text-sm text-gray-600 transition-colors hover:text-gray-900 aria-pressed:border-brand-300 aria-pressed:bg-brand-50 aria-pressed:text-brand-700";
const msg = "rounded-lg px-3 py-2";
const who = "flex items-center gap-1.5 text-xs text-gray-500";
---

<section id="get-started" class="setup mx-auto mt-32 grid max-w-6xl scroll-mt-8 items-center gap-12 px-6 md:grid-cols-[minmax(0,1fr)_auto] lg:gap-20">
  <div>
    <h2 class="text-[40px] leading-[1.05] font-[550] tracking-[-0.035em]">Give your agent an inbox</h2>
    <p class="mt-3 max-w-lg text-lg text-gray-500">Pick what you run today. Copy the prompt into your agent and it sets itself up.</p>

    <div class="mt-10 flex flex-col gap-7">
      <div>
        <p class="text-sm font-medium text-gray-500">Your agent</p>
        <div class="mt-2.5 flex flex-wrap gap-2">
          {
            agents.map((a, i) => (
              <button type="button" data-agent={a.key} data-label={a.label} aria-pressed={i === 0 ? "true" : "false"} class={chip}>
                <Logo name={a.key} class="size-4" /> {a.label}
              </button>
            ))
          }
        </div>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-500">Instead of</p>
        <div class="mt-2.5 flex flex-wrap gap-2">
          {
            replaces.map((r, i) => (
              <button type="button" data-view={r.key} data-title={r.title} data-text={r.text} aria-pressed={i === 0 ? "true" : "false"} class={chip}>
                {r.icon === "telegram" ? (
                  <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d={siTelegram.path} /></svg>
                ) : (
                  <Icon name={r.icon} class="size-4" />
                )}
                {r.label}
              </button>
            ))
          }
        </div>
        <p class="view-text mt-4 max-w-lg text-lg leading-relaxed text-gray-500">
          <span class="font-medium text-gray-900">{replaces[0]!.title}</span> <span>{replaces[0]!.text}</span>
        </p>
      </div>

      <div class="generic">
        <p class="text-sm font-medium text-gray-500">Server</p>
        <div class="mt-2.5 flex flex-wrap gap-2">
          {
            servers.map((p, i) => (
              <button
                type="button"
                data-server={hosts[p.key]}
                data-prompt={promptFor(p)}
                data-note={serverNote(p)}
                data-docs={p === hosted ? "/docs/start/quickstart/" : "/docs/self-hosting/overview/"}
                aria-pressed={i === 0 ? "true" : "false"}
                class={chip}
              >
                {p === hosted ? <Icon name="check" class="size-4" /> : p.logo ? <Logo name={p.logo} class="size-4" /> : <Icon name="laptop" class="size-4" />}
                {p.label}
              </button>
            ))
          }
        </div>
        <p class="server-note mt-3 text-[15px] text-gray-500">{serverNote(hosted)}</p>
      </div>
    </div>

    <div hidden class="hermes mt-10 max-w-lg overflow-hidden rounded-xl border border-[#CD7F32]/60 bg-[#0b0d12] font-mono text-[13px] shadow-[0_20px_40px_-20px_rgb(0_0_0/0.5)]">
      <div class="flex items-center justify-between border-b border-[#CD7F32]/40 px-4 py-2.5">
        <span class="flex items-center gap-2 font-semibold tracking-wide whitespace-nowrap text-[#FFD700]"><Logo name="hermes" class="size-4" /> ⚕ HERMES AGENT</span>
        <span class="hidden text-xs text-[#B8860B] sm:inline">paste this to your Hermes</span>
      </div>
      <p class="px-4 pt-3.5 pb-4 leading-relaxed whitespace-pre-wrap text-[#FFF8DC]"><span class="text-[#FFBF00]">❯ </span>{hermesPrompt}</p>
      <div class="flex items-center gap-4 border-t border-[#CD7F32]/40 px-4 py-3">
        <button class="copy-setup group inline-flex h-9 items-center rounded-lg bg-[#FFD700] px-4 font-semibold text-[#0b0d12] transition-colors hover:bg-[#FFBF00]" data-prompt={hermesPrompt}>
          <span class="grid [&>*]:[grid-area:1/1]"><span class="flex items-center gap-2 group-[.copied]:invisible"><Icon name="copy" class="size-4" /> Copy prompt</span><span class="invisible flex items-center justify-center gap-2 group-[.copied]:visible"><Icon name="check" class="size-4" /> Copied</span></span>
        </button>
        <a href="/docs/integrations/hermes/" class:list={["text-[#B8860B] underline-offset-4 hover:text-[#FFD700] hover:underline", tagged("Hermes docs")]}>Set it up by hand</a>
      </div>
    </div>

    <div class="generic mt-10 flex flex-wrap items-center gap-3">
      <button class="copy-setup group btn btn-dark h-12 px-6 text-base" data-prompt={promptFor(hosted)}>
        <span class="grid [&>*]:[grid-area:1/1]"><span class="flex items-center gap-2 group-[.copied]:invisible"><Icon name="copy" class="size-4" /> Copy setup prompt</span><span class="invisible flex items-center justify-center gap-2 group-[.copied]:visible"><Icon name="check" class="size-4" /> Copied</span></span>
      </button>
      <a href="/docs/start/quickstart/" class:list={["manual btn btn-outline h-12 px-6 text-base", tagged("Set up by hand")]}>Set it up by hand</a>
    </div>
  </div>

  <div class="phone relative mx-auto w-[290px] rounded-[48px] bg-gray-900 p-[10px] shadow-[0_30px_60px_-20px_rgb(0_0_0/0.35)]">
    <div class="relative flex h-[540px] flex-col overflow-hidden rounded-[38px] bg-white text-[13px]">
      <div class="flex h-11 flex-none items-center justify-between px-7 pt-1 text-[13px] font-semibold text-gray-900">
        <span>9:41</span>
        <span class="absolute top-2.5 left-1/2 h-[26px] w-[86px] -translate-x-1/2 rounded-full bg-gray-900"></span>
        <span class="h-2.5 w-4 rounded-[3px] border border-gray-900"></span>
      </div>
      <div class="flex flex-none items-center gap-2 border-b border-gray-200 px-4 pb-2.5">
        <span class="text-xl leading-none text-gray-500">‹</span>
        <span data-agent-bird data-bird="claude" data-size="28" data-dot="off" class="block size-[28px] flex-none [&>svg]:size-full"></span>
        <div class="min-w-0">
          <p class="font-medium text-gray-900" data-agent-name>Claude Code</p>
          <p class="text-xs text-gray-500" data-server-name>app.rply.sh</p>
        </div>
      </div>

      <div class="relative flex flex-1 flex-col justify-end overflow-hidden px-3 pb-2">
        <div data-screen="telegram" class="flex flex-col gap-0.5">
          <div class={msg}><p class={who}><span data-agent-bird data-bird="claude" data-size="18" data-dot="off" class="block size-[18px] flex-none [&>svg]:size-full"></span><span class="font-medium text-gray-900" data-agent-name>Claude Code</span> 9:12</p><p class="mt-0.5">Started the deploy for acme.dev.</p></div>
          <div class="msg-in absolute inset-x-0 top-2 flex gap-2.5 rounded-2xl bg-white/90 p-3 shadow-[0_8px_24px_rgb(0_0_0/0.15)] ring-1 ring-black/5">
            <span class="grid size-8 flex-none place-items-center rounded-lg bg-gray-100"><span data-agent-bird data-bird="claude" data-size="20" data-dot="off" class="block size-[20px] flex-none [&>svg]:size-full"></span></span>
            <div class="min-w-0 leading-snug">
              <p class="flex justify-between font-semibold text-gray-900"><span data-agent-name>Claude Code</span> <span class="font-normal text-gray-500">now</span></p>
              <p class="text-gray-700">Deploy finished, 3 new pages are live.</p>
            </div>
          </div>
          <div class={msg}><p class={who}><span data-agent-bird data-bird="claude" data-size="18" data-dot="off" class="block size-[18px] flex-none [&>svg]:size-full"></span><span class="font-medium text-gray-900" data-agent-name>Claude Code</span> 9:40</p><p class="mt-0.5">Deploy finished, 3 new pages are live.</p></div>
          <div class:list={[msg, "msg-in bg-gray-100 [animation-delay:0.4s]"]}><p class={who}><span class="font-medium text-gray-900">You</span> 9:41</p><p class="mt-0.5">Nice. Post the changelog too.</p></div>
          <div class:list={[msg, "msg-in [animation-delay:0.9s]"]}><p class={who}><span data-agent-bird data-bird="claude" data-size="18" data-dot="off" class="block size-[18px] flex-none [&>svg]:size-full"></span><span class="font-medium text-gray-900" data-agent-name>Claude Code</span> 9:41</p><p class="mt-0.5">Posted.</p></div>
        </div>

        <div data-screen="site" hidden class="flex flex-col gap-0.5">
          <div class="msg-in absolute inset-x-0 top-2 rounded-lg bg-gray-100 px-3 py-2.5">
            <p class="flex justify-between"><span class="font-medium text-gray-900">Status</span><span class="text-xs text-gray-500">Pinned</span></p>
            <p class="mt-2 flex justify-between text-gray-600">Migrating users <span class="tabular-nums">72%</span></p>
            <div class="mt-1.5 h-1 rounded-full bg-gray-200"><div class="h-full w-[72%] rounded-full bg-gray-800"></div></div>
            <dl class="mt-3 grid grid-cols-3 gap-2">
              {[["Rows", "1.2M"], ["Errors", "0"], ["Left", "9 min"]].map(([k, v]) => <div><dt class="text-xs text-gray-500">{k}</dt><dd class="text-base font-medium text-gray-900 tabular-nums">{v}</dd></div>)}
            </dl>
          </div>
          <div class={msg}><p class={who}><span data-agent-bird data-bird="claude" data-size="18" data-dot="off" class="block size-[18px] flex-none [&>svg]:size-full"></span><span class="font-medium text-gray-900" data-agent-name>Claude Code</span> 9:20</p><p class="mt-0.5">Starting the migration. I'll keep the status pinned.</p></div>
          <div class:list={[msg, "msg-in [animation-delay:0.4s]"]}><p class={who}><span data-agent-bird data-bird="claude" data-size="18" data-dot="off" class="block size-[18px] flex-none [&>svg]:size-full"></span><span class="font-medium text-gray-900" data-agent-name>Claude Code</span> 9:41</p><p class="mt-0.5">Copying rows, verifying as I go.</p></div>
        </div>

        <div data-screen="ask" hidden class="flex flex-col gap-0.5">
          <div class="ml-auto max-w-[85%] rounded-lg bg-gray-100 px-3 py-2">Draft pages for the top keywords</div>
          <div class={msg}><p class={who}><span data-agent-bird data-bird="claude" data-size="18" data-dot="off" class="block size-[18px] flex-none [&>svg]:size-full"></span><span class="font-medium text-gray-900" data-agent-name>Claude Code</span> 9:40</p><p class="mt-0.5">Drafted 5 pages: /pricing, /compare, /faq, /security and /teams.</p></div>
          <div class:list={["msg-in rounded-r-lg border-l-2 border-brand-600 px-3 py-2 [animation-delay:0.4s]"]}>
            <p class={who}><span data-agent-bird data-bird="claude" data-size="18" data-dot="off" class="block size-[18px] flex-none [&>svg]:size-full"></span><span class="font-medium text-gray-900" data-agent-name>Claude Code</span> 9:41</p>
            <p class="mt-0.5">Publish them to acme.dev now?</p>
            <div class="mt-2 flex gap-1.5">
              <span class="btn btn-primary h-7 flex-1 justify-center px-2 text-[13px]">Publish</span>
              <span class="btn btn-outline h-7 flex-1 justify-center px-2 text-[13px]">Not yet</span>
            </div>
          </div>
        </div>

        <div data-screen="keys" hidden class="flex flex-col gap-0.5">
          <div class="ml-auto max-w-[85%] rounded-lg bg-gray-100 px-3 py-2">Set up Stripe billing</div>
          <div class={msg}><p class={who}><span data-agent-bird data-bird="claude" data-size="18" data-dot="off" class="block size-[18px] flex-none [&>svg]:size-full"></span><span class="font-medium text-gray-900" data-agent-name>Claude Code</span> 9:40</p><p class="mt-0.5">I need a Stripe key to set up billing.</p></div>
          <div class="msg-in mx-3 rounded-xl border border-gray-200 p-3 [animation-delay:0.4s]">
            <p class="flex items-center gap-1.5 font-medium text-gray-900"><Icon name="lock" class="size-3.5 text-gray-500" /> STRIPE_SECRET_KEY</p>
            <p class="mt-0.5 text-xs text-gray-500">Written to ~/app/.env</p>
            <div class="mt-2.5 flex gap-1.5">
              <span class="flex h-7 flex-1 items-center rounded-lg border border-gray-200 px-2 font-mono tracking-widest text-gray-500">••••••••••</span>
              <span class="btn btn-primary h-7 px-2.5 text-[13px]">Send</span>
            </div>
            <p class="mt-2.5 text-xs text-gray-500">Encrypted on this phone. The agent never sees it.</p>
          </div>
        </div>

        <div data-screen="ssh" hidden class="flex flex-col gap-0.5">
          <div class={msg}><p class={who}><span data-agent-bird data-bird="claude" data-size="18" data-dot="off" class="block size-[18px] flex-none [&>svg]:size-full"></span><span class="font-medium text-gray-900" data-agent-name>Claude Code</span> 9:30</p><p class="mt-0.5">The pricing page is live.</p></div>
          <div class="msg-in ml-auto max-w-[85%] rounded-lg bg-gray-100 px-3 py-2">Add a page for the Teams plan</div>
          <p class="msg-in px-1 text-right text-xs text-gray-500 [animation-delay:0.5s]">Done</p>
          <div class:list={[msg, "msg-in [animation-delay:0.9s]"]}><p class={who}><span data-agent-bird data-bird="claude" data-size="18" data-dot="off" class="block size-[18px] flex-none [&>svg]:size-full"></span><span class="font-medium text-gray-900" data-agent-name>Claude Code</span> 9:44</p><p class="mt-0.5">Done, it's live at /pricing/teams.</p></div>
        </div>
      </div>

      <div class="mx-3 mb-6 flex flex-none items-center justify-between rounded-xl bg-gray-100 px-3 py-2.5 text-gray-400">
        <span>Message <span data-agent-name>Claude Code</span></span>
        <Icon name="arrow-up" class="size-4" />
      </div>
      <span class="absolute bottom-2 left-1/2 h-1 w-28 -translate-x-1/2 rounded-full bg-gray-900"></span>
    </div>
  </div>
</section>

<script>
  import { flutter } from "./flutter.ts";
  import { chirp, mountBirds } from "./agent-bird.ts";
  import { track } from "./track.ts";

  document.querySelectorAll<HTMLElement>(".setup").forEach((root) => {
    const phone = root.querySelector<HTMLElement>(".phone")!;
    const copy = root.querySelector<HTMLElement>(".generic .copy-setup")!;
    const manual = root.querySelector<HTMLAnchorElement>(".manual")!;
    const viewText = root.querySelector<HTMLElement>(".view-text")!;
    const serverNote = root.querySelector<HTMLElement>(".server-note")!;
    mountBirds(phone);

    const picked = { agent: "Claude Code", server: "app.rply.sh" };
    const group = (attr: string, event: string, onPick: (b: HTMLElement) => void) => {
      const buttons = root.querySelectorAll<HTMLElement>(`[data-${attr}]`);
      buttons.forEach((b) =>
        b.addEventListener("click", () => {
          buttons.forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
          onPick(b);
          track(event, { value: b.textContent!.trim() });
        }),
      );
    };

    group("agent", "Pick agent", (b) => {
      picked.agent = b.dataset.label!;
      const hermes = b.dataset.agent === "hermes";
      root.querySelectorAll<HTMLElement>(".generic").forEach((el) => (el.hidden = hermes));
      root.querySelector<HTMLElement>(".hermes")!.hidden = !hermes;
      phone.querySelectorAll("[data-agent-name]").forEach((el) => (el.textContent = b.dataset.label!));
      phone.querySelectorAll<HTMLElement>("[data-agent-bird]").forEach((el) => {
        const next = el.cloneNode() as HTMLElement;
        delete next.dataset.birdOn;
        next.dataset.bird = b.dataset.agent!;
        el.replaceWith(next);
      });
      mountBirds(phone);
      chirp(b.dataset.agent!);
    });

    group("view", "Pick alternative", (b) => {
      phone.querySelectorAll<HTMLElement>("[data-screen]").forEach((s) => (s.hidden = s.dataset.screen !== b.dataset.view));
      viewText.children[0]!.textContent = b.dataset.title!;
      viewText.children[1]!.textContent = b.dataset.text!;
    });

    group("server", "Pick server", (b) => {
      picked.server = b.textContent!.trim();
      phone.querySelector("[data-server-name]")!.textContent = b.dataset.server!;
      copy.dataset.prompt = b.dataset.prompt!;
      manual.href = b.dataset.docs!;
      serverNote.textContent = b.dataset.note!;
    });

    root.querySelectorAll<HTMLElement>(".copy-setup").forEach((b) =>
      b.addEventListener("click", async () => {
        track("Copy setup prompt", { location: "setup", ...picked });
        flutter(b);
        b.classList.add("copied");
        setTimeout(() => b.classList.remove("copied"), 2000);
        await navigator.clipboard.writeText(b.dataset.prompt!);
      }),
    );
  });
</script>
