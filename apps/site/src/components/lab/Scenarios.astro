---
import Icon from "./Icon.astro";

type Line = { step: number; cmd?: string; out?: string };
type Item =
  | { step: number; type: "agent"; text: string }
  | { step: number; type: "you"; text: string; states: Record<number, string> }
  | { step: number; type: "ask"; text: string; choices: string[]; press: number }
  | { step: number; type: "status"; rows: Record<number, string>; widths: Record<number, string>; eta: Record<number, string> }
  | { step: number; type: "secret"; name: string; reason: string; dots: Record<number, string>; note: Record<number, string> }
  | { step: number; type: "app"; press: number; note: Record<number, string> };

type Scenario = { tab: string; agent: string; channel: string; prompt: string; terminal: Line[]; thread: Item[] };

const scenarios: Scenario[] = [
  {
    tab: "Approvals",
    agent: "Claude Code",
    channel: "SEO bot",
    prompt: "Draft the 5 pricing pages for acme.dev, but ask me before anything goes live.",
    terminal: [
      { step: 1, cmd: `rply send "Drafted all 5 pages"` },
      { step: 2, cmd: `rply ask "Publish them now?" --choices Publish,"Not yet" --wait` },
      { step: 4, out: "Publish" },
      { step: 5, cmd: `./deploy.sh && rply send "All 5 pages are live"` },
    ],
    thread: [
      { step: 1, type: "agent", text: "Drafted all 5: /pricing, /pricing/teams, /compare, /faq and /security." },
      { step: 2, type: "ask", text: "Publish them to acme.dev now?", choices: ["Publish", "Not yet"], press: 3 },
      { step: 5, type: "agent", text: "All 5 pages are live. Indexing requested." },
    ],
  },
  {
    tab: "Long jobs",
    agent: "Codex",
    channel: "DB migration",
    prompt: "Move the users table to the new cluster and keep me posted while it runs.",
    terminal: [
      { step: 1, cmd: "rply status set --blocks status.json" },
      { step: 2, cmd: `rply status patch --patch '{"id":"rows","value":1.4}'` },
      { step: 3, cmd: `rply status patch --patch '{"id":"rows","value":3.1}'` },
      { step: 5, cmd: `rply send "Migration done in 14 minutes"` },
    ],
    thread: [
      {
        step: 1,
        type: "status",
        rows: { 1: "0.2M of 4.8M rows", 2: "1.4M of 4.8M rows", 3: "3.1M of 4.8M rows", 4: "4.8M of 4.8M rows" },
        widths: { 1: "4%", 2: "29%", 3: "65%", 4: "100%" },
        eta: { 1: "14 min", 2: "10 min", 3: "5 min", 4: "Done" },
      },
      { step: 5, type: "agent", text: "Migration finished in 14 minutes with no errors. The old table is kept as users_old." },
    ],
  },
  {
    tab: "New work",
    agent: "Claude Code",
    channel: "SEO bot",
    prompt: "Whenever you finish a task, check rply for new work from me.",
    terminal: [
      { step: 2, cmd: "rply inbox --wait" },
      { step: 2, out: `"Add a page for the new Teams plan"` },
      { step: 3, cmd: "rply ack msg_8f2 working" },
      { step: 5, cmd: "rply ack msg_8f2 done" },
    ],
    thread: [
      { step: 1, type: "you", text: "Add a page for the new Teams plan", states: { 1: "Sent", 2: "Seen", 3: "Working on it", 5: "Done" } },
      { step: 4, type: "agent", text: "Added /pricing/teams with the new plan table. Preview is up at acme.dev/pricing/teams." },
    ],
  },
  {
    tab: "API keys",
    agent: "Claude Code",
    channel: "Shop agent",
    prompt: "Set up Stripe webhooks. Ask me for the key when you need it.",
    terminal: [
      { step: 1, cmd: "rply secret request STRIPE_SECRET_KEY --to .env --wait" },
      { step: 4, out: "STRIPE_SECRET_KEY written to /srv/shop/.env" },
      { step: 5, cmd: `rply send "Webhooks are set up"` },
    ],
    thread: [
      {
        step: 1,
        type: "secret",
        name: "STRIPE_SECRET_KEY",
        reason: "For the webhook endpoint. Written to /srv/shop/.env",
        dots: { 1: "", 2: "••••••••", 3: "••••••••••••••••" },
        note: { 1: "Encrypted on this device before it's sent", 3: "Sent, encrypted for shop-agent", 4: "Delivered. The server kept no copy." },
      },
      { step: 5, type: "agent", text: "Stripe webhooks are set up. A test event came through." },
    ],
  },
  {
    tab: "Dashboards",
    agent: "Claude Code",
    channel: "SEO bot",
    prompt: "Build me a rankings dashboard with a button to re-run the audit.",
    terminal: [
      { step: 1, cmd: "rply app set rankings rankings.html" },
      { step: 1, out: "created" },
      { step: 3, out: `call "audit" from Rankings` },
      { step: 3, cmd: "./scripts/audit.sh" },
    ],
    thread: [{ step: 1, type: "app", press: 3, note: { 1: "Last audit: Monday", 3: "Audit running, 18 of 40 pages", 5: "Audit done. 3 new issues." } }],
  },
];

const bars = [38, 46, 41, 58, 64, 79, 92];
const json = (o: object) => JSON.stringify(o);
---

<div class="scenarios" data-scenarios>
  <div class="mx-auto flex w-fit flex-wrap justify-center gap-1 rounded-xl bg-gray-100 p-1" role="tablist">
    {
      scenarios.map((s, i) => (
        <button
          role="tab"
          data-tab={i}
          aria-selected={i === 0 ? "true" : "false"}
          class="relative overflow-hidden rounded-lg px-4 py-2 text-sm text-gray-500 aria-selected:bg-white aria-selected:text-gray-900 aria-selected:shadow-[0_1px_2px_rgb(0_0_0/0.08)]"
        >
          {s.tab}
          <span class="progress absolute bottom-0 left-0 h-0.5 w-0 bg-brand-500" />
        </button>
      ))
    }
  </div>

  <div class="mt-6 rounded-3xl bg-gray-100 p-4 md:p-8">
    {
      scenarios.map((s, i) => (
        <div data-panel={i} hidden={i !== 0} class="grid gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:items-start">
          <div class="flex flex-col">
            <div class="rounded-xl border border-gray-200 bg-white p-4">
              <p class="text-[13px] text-gray-500">You, to {s.agent}</p>
              <p class="mt-1.5 text-[15px] leading-snug text-gray-900">{s.prompt}</p>
            </div>
            <span class="mx-auto h-6 w-px bg-gray-300" />
            <div class="min-h-[184px] rounded-xl bg-gray-900 p-4 font-mono text-xs leading-5 text-gray-300">
              <p class="mb-2 font-sans text-[13px] text-gray-500">{s.agent} runs</p>
              {s.terminal.map((l) => (
                <p data-step={l.step} hidden class:list={["msg-in break-all", l.out && "text-brand-300"]}>
                  {l.cmd ? (
                    <>
                      <span class="text-gray-500">$</span> {l.cmd}
                    </>
                  ) : (
                    l.out
                  )}
                </p>
              ))}
            </div>
          </div>

          <div class="flex h-[420px] flex-col overflow-hidden rounded-xl border border-gray-200 bg-white text-[13px]">
            <div class="flex h-11 flex-none items-center border-b border-gray-200 px-4 text-sm font-medium text-gray-900">
              {s.channel}
              <Icon name="ellipsis" class="ml-auto size-4 text-gray-500" />
            </div>
            <div class="flex flex-1 flex-col justify-end gap-1 overflow-hidden p-3">
              {s.thread.map((m) => (
                <div data-step={m.step} hidden class="msg-in">
                  {m.type === "agent" && (
                    <div class="rounded-lg px-3 py-2.5">
                      <p class="text-gray-500"><span class="font-medium text-gray-900">{s.channel}</span> now</p>
                      <p class="mt-1 text-sm">{m.text}</p>
                    </div>
                  )}
                  {m.type === "you" && (
                    <div class="rounded-lg bg-gray-100 px-3 py-2.5">
                      <p class="text-gray-500">
                        <span class="font-medium text-gray-900">You</span> now · <span data-t={json(m.states)} />
                      </p>
                      <p class="mt-1 text-sm">{m.text}</p>
                    </div>
                  )}
                  {m.type === "ask" && (
                    <div class="rounded-r-lg border-l-2 border-brand-600 px-3 py-2.5" data-answered-border={m.press}>
                      <p class="text-gray-500"><span class="font-medium text-gray-900">{s.channel}</span> now</p>
                      <p class="mt-1 text-sm">{m.text}</p>
                      <div class="mt-2.5 flex gap-2">
                        {m.choices.map((c, ci) => (
                          <span class="btn btn-outline h-8" data-press={ci === 0 ? m.press : undefined} data-dim={ci === 0 ? undefined : m.press}>
                            {c}
                          </span>
                        ))}
                      </div>
                    </div>
                  )}
                  {m.type === "status" && (
                    <div class="mx-1 mb-auto rounded-lg bg-gray-100 p-3">
                      <p class="flex justify-between text-gray-500">Status <span class="text-xs">Pinned</span></p>
                      <dl class="mt-2 grid grid-cols-3 gap-2">
                        <div><dt class="text-xs text-gray-500">Rows</dt><dd class="text-base font-semibold text-gray-900 tabular-nums" data-t={json(Object.fromEntries(Object.entries(m.rows).map(([k, v]) => [k, v.split(" of")[0]])))} /></div>
                        <div><dt class="text-xs text-gray-500">Errors</dt><dd class="text-base font-semibold text-gray-900 tabular-nums">0</dd></div>
                        <div><dt class="text-xs text-gray-500">Time left</dt><dd class="text-base font-semibold text-gray-900 tabular-nums" data-t={json(m.eta)} /></div>
                      </dl>
                      <p class="mt-3 flex justify-between"><span>Copying users</span><span class="text-gray-500 tabular-nums" data-t={json(m.rows)} /></p>
                      <div class="mt-1.5 h-1 rounded-full bg-gray-200"><div class="h-full w-0 rounded-full bg-gray-800 transition-[width] duration-1000" data-w={json(m.widths)} /></div>
                    </div>
                  )}
                  {m.type === "secret" && (
                    <div class="mx-1 rounded-xl border border-gray-200 p-4">
                      <p class="flex items-center gap-2 font-medium text-gray-900"><Icon name="lock" class="size-3.5 text-gray-500" /> {m.name}</p>
                      <p class="mt-0.5 text-gray-500">{m.reason}</p>
                      <div class="mt-3 flex gap-2">
                        <span class="flex h-8 flex-1 items-center rounded-lg border border-gray-200 px-3 font-mono tracking-widest text-gray-500" data-t={json(m.dots)} />
                        <span class="btn btn-outline h-8" data-press="3">Send</span>
                      </div>
                      <p class="mt-3 text-xs text-gray-500" data-t={json(m.note)} />
                    </div>
                  )}
                  {m.type === "app" && (
                    <div class="mx-1 mb-auto">
                      <p class="flex items-center gap-2 text-gray-500"><Icon name="app" class="size-3.5" /> {s.channel} / <span class="text-gray-900">Rankings</span></p>
                      <p class="mt-4 font-medium text-gray-900">Clicks this week <span class="ml-2 font-normal text-gray-500">+38%</span></p>
                      <div class="mt-3 flex h-32 items-end gap-2">
                        {bars.map((h, bi) => (
                          <span class="bar-grow flex-1 origin-bottom rounded-t-sm bg-brand-400" style={`height:${h}%;animation-delay:${bi * 60}ms`} />
                        ))}
                      </div>
                      <div class="mt-4 flex items-center gap-3">
                        <span class="btn btn-outline h-8" data-press={m.press}>Re-run audit</span>
                        <span class="text-gray-500" data-t={json(m.note)} />
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .bar-grow {
    animation: grow 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }
</style>

<script>
  const STEP = 1300;
  const HOLD = 3500;
  const LAST = 5;

  document.querySelectorAll<HTMLElement>("[data-scenarios]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLElement>("[data-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = 0;
    let timers: number[] = [];

    const pick = (map: Record<string, string>, step: number) =>
      Object.entries(map).reduce((value, [at, v]) => (Number(at) <= step ? v : value), "");

    const render = (panel: HTMLElement, step: number) => {
      panel.querySelectorAll<HTMLElement>("[data-step]").forEach((el) => (el.hidden = Number(el.dataset.step) > step));
      panel.querySelectorAll<HTMLElement>("[data-t]").forEach((el) => (el.textContent = pick(JSON.parse(el.dataset.t!), step)));
      panel.querySelectorAll<HTMLElement>("[data-w]").forEach((el) => (el.style.width = pick(JSON.parse(el.dataset.w!), step) || "0"));
      panel.querySelectorAll<HTMLElement>("[data-press]").forEach((el) => {
        const on = step >= Number(el.dataset.press);
        el.classList.toggle("btn-primary", on);
        el.classList.toggle("btn-outline", !on);
      });
      panel.querySelectorAll<HTMLElement>("[data-dim]").forEach((el) => el.classList.toggle("opacity-40", step >= Number(el.dataset.dim)));
      panel.querySelectorAll<HTMLElement>("[data-answered-border]").forEach((el) =>
        el.classList.toggle("border-transparent", step >= Number(el.dataset.answeredBorder)),
      );
    };

    const show = (index: number, autoplay: boolean) => {
      timers.forEach(clearTimeout);
      timers = [];
      current = index;
      tabs.forEach((t, i) => {
        t.setAttribute("aria-selected", String(i === index));
        const bar = t.querySelector<HTMLElement>(".progress")!;
        bar.style.transition = "none";
        bar.style.width = "0";
      });
      panels.forEach((p, i) => (p.hidden = i !== index));
      const panel = panels[index];

      if (reduced) return render(panel, LAST);
      render(panel, 0);
      for (let step = 1; step <= LAST; step++) timers.push(window.setTimeout(() => render(panel, step), step * STEP));
      if (!autoplay) return;
      const total = LAST * STEP + HOLD;
      const bar = tabs[index].querySelector<HTMLElement>(".progress")!;
      requestAnimationFrame(() => {
        bar.style.transition = `width ${total}ms linear`;
        bar.style.width = "100%";
      });
      timers.push(window.setTimeout(() => show((index + 1) % panels.length, true), total));
    };

    tabs.forEach((t, i) => t.addEventListener("click", () => show(i, false)));

    let started = false;
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !started) {
          started = true;
          show(current, true);
        }
      },
      { threshold: 0.4 },
    ).observe(root);
  });
</script>
