---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import Bird from "./Bird.astro";
import { siRailway, siFlydotio, siRender, siHetzner } from "simple-icons";
import { hosted, selfHosted, promptFor, type Platform } from "./setup.ts";

const tiles: Record<string, { bg: string; path?: string; src?: string; fg?: string }> = {
  exe: { bg: "bg-white", src: "/logos/exe.png" },
  railway: { bg: "bg-gray-950", path: siRailway.path, fg: "#fff" },
  fly: { bg: "bg-[#24175B]", path: siFlydotio.path, fg: "#fff" },
  render: { bg: "bg-gray-950", path: siRender.path, fg: "#fff" },
  vps: { bg: "bg-[#D50C2D]", path: siHetzner.path, fg: "#fff" },
};
const tile = "grid flex-none place-items-center rounded-[22%] ring-1 ring-black/5 shadow-[0_1px_2px_rgb(0_0_0/0.06),0_8px_18px_-12px_rgb(0_0_0/0.35)]";
const option =
  "group relative rounded-2xl border border-gray-200 bg-white text-left transition-colors hover:bg-gray-50 aria-checked:border-brand-500 aria-checked:ring-1 aria-checked:ring-brand-500";
const radio =
  "grid size-5 flex-none place-items-center rounded-full border border-gray-300 group-aria-checked:border-brand-600 group-aria-checked:bg-brand-500";
const agents = ["claude", "codex", "cursor", "gemini", "openclaw"] as const;

const detail = (p: Platform) => ({
  intro:
    p === hosted
      ? "Wherever it runs, on exe.dev, a VPS or your laptop, it creates its channel on app.rply.sh and sends you a link to add it to your account."
      : "It deploys the server, you create your account, and it sends you a link to add its channel.",
  steps: p === hosted ? p.steps : [...p.steps, { text: "Open your server's URL. The app walks you through connecting your agent." }],
});
---

<section id="get-started" class="get-started mx-auto mt-32 max-w-6xl scroll-mt-8 px-6">
  <h2 class="text-center text-[40px] leading-[1.05] font-[550] tracking-[-0.035em]">Get started</h2>
  <p class="mt-3 text-center text-lg text-gray-500">Start free on app.rply.sh, or run it on your own server. It's open source.</p>

  <div class="mt-10 grid gap-3 md:grid-cols-2" role="radiogroup" aria-label="Hosted or self-hosted">
    <button role="radio" data-mode="hosted" aria-checked="true" class:list={[option, "flex items-start gap-4 p-5 sm:gap-5 sm:p-6"]}>
      <span class:list={[tile, "size-12 border border-brand-600 bg-linear-to-b from-brand-400 to-brand-500 text-white sm:size-14"]}><Bird class="size-6 sm:size-7" /></span>
      <span class="min-w-0 flex-1">
        <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <span class="text-xl font-[550] tracking-[-0.02em] text-gray-900">Use app.rply.sh</span>
          <span class="rounded-full bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700">Free to start</span>
        </span>
        <span class="mt-1 block text-[15px] text-gray-500">Nothing to deploy. Works wherever your agent runs, exe.dev included.</span>
        <span class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[13px] text-gray-600">
          {["Web app and push", "Ready in a minute"].map((item) => (
            <span class="flex items-center gap-1.5"><Icon name="check" class="size-3.5 text-brand-500" /> {item}</span>
          ))}
        </span>
      </span>
      <span class={radio}><span class="size-2 rounded-full bg-white opacity-0 group-aria-checked:opacity-100" /></span>
    </button>

    <button role="radio" data-mode="self" aria-checked="false" class:list={[option, "flex items-start gap-4 p-5 sm:gap-5 sm:p-6"]}>
      <span class:list={[tile, "size-12 bg-gray-900 text-white sm:size-14"]}><Icon name="server" class="size-6 sm:size-7" /></span>
      <span class="min-w-0 flex-1">
        <span class="block text-xl font-[550] tracking-[-0.02em] text-gray-900">Self-host</span>
        <span class="mt-1 block text-[15px] text-gray-500">Run the server yourself. One Docker container with SQLite.</span>
        <span class="mt-3 flex gap-1">
          {
            selfHosted.map((p) => {
              const t = tiles[p.key];
              return (
                <span class:list={[tile, "size-7 shadow-none", t?.bg ?? "bg-gray-100"]}>
                  {t?.path ? (
                    <svg viewBox="0 0 24 24" class="size-3.5" fill={t.fg} aria-hidden="true"><path d={t.path} /></svg>
                  ) : t?.src ? (
                    <img src={t.src} alt="" class="size-5 object-contain" />
                  ) : (
                    <Icon name="laptop" class="size-3.5 text-gray-700" />
                  )}
                </span>
              );
            })
          }
        </span>
      </span>
      <span class={radio}><span class="size-2 rounded-full bg-white opacity-0 group-aria-checked:opacity-100" /></span>
    </button>
  </div>

  <div data-mode-panel="self" hidden class="msg-in mt-3">
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6" role="radiogroup" aria-label="Where to self-host">
      {
        selfHosted.map((p, i) => {
          const t = tiles[p.key];
          return (
            <button
              role="radio"
              data-platform={p.key}
              aria-checked={i === 0 ? "true" : "false"}
              class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-2.5 text-left transition-colors hover:bg-gray-50 aria-checked:border-brand-500 aria-checked:ring-1 aria-checked:ring-brand-500"
            >
              <span class:list={[tile, "size-9", t?.bg ?? "bg-gray-100"]}>
                {t?.path ? (
                  <svg viewBox="0 0 24 24" class="size-4.5" fill={t.fg} aria-hidden="true"><path d={t.path} /></svg>
                ) : t?.src ? (
                  <img src={t.src} alt="" class="size-6 object-contain" />
                ) : (
                  <Icon name="laptop" class="size-4.5 text-gray-700" />
                )}
              </span>
              <span class="min-w-0">
                <span class="block truncate text-sm font-medium text-gray-900">{p.label}</span>
                <span class="block truncate text-xs text-gray-500">{p.note}</span>
              </span>
            </button>
          );
        })
      }
    </div>
  </div>

  {
    [hosted, ...selfHosted].map((p) => {
      const d = detail(p);
      return (
        <div data-detail={p.key} hidden={p !== hosted} class="msg-in mt-4 grid gap-4 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
          <div class="flex flex-col rounded-3xl bg-gray-100 p-6 sm:p-8">
            <div class="flex gap-2">
              {agents.map((a) => (
                <span class="grid size-10 place-items-center rounded-xl bg-white">
                  <Logo name={a} />
                </span>
              ))}
            </div>
            <h3 class="mt-6 text-2xl font-[550] tracking-[-0.02em]">Let your agent set it up</h3>
            <p class="mt-2 text-[15px] text-gray-500">{d.intro}</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <button class="copy-setup group btn btn-primary h-12 px-6 text-base" data-prompt={promptFor(p)}>
                <span class="grid [&>*]:[grid-area:1/1]"><span class="flex items-center gap-2 group-[.copied]:invisible"><Icon name="copy" class="size-4" /> Copy setup prompt</span><span class="invisible flex items-center justify-center gap-2 group-[.copied]:visible"><Icon name="check" class="size-4" /> Copied</span></span>
              </button>
              {p === hosted && <a href="https://app.rply.sh" class="btn btn-outline h-12 px-6 text-base">Go to app</a>}
            </div>
          </div>

          <div class="rounded-3xl border border-gray-200 p-6 sm:p-8">
            <h3 class="text-2xl font-[550] tracking-[-0.02em]">Or do it by hand</h3>
            <ol class="mt-6 flex flex-col gap-5">
              {d.steps.map((s, si) => (
                <li class="grid grid-cols-[1.75rem_minmax(0,1fr)] gap-3">
                  <span class="grid size-7 place-items-center rounded-full bg-gray-100 text-[13px] font-medium text-gray-600">{si + 1}</span>
                  <div class="min-w-0 pt-0.5">
                    <p class="text-[15px]">{s.text}</p>
                    {s.code && <pre class="mt-2 overflow-x-auto rounded-xl bg-gray-900 px-4 py-3 font-mono text-[13px] leading-6 text-gray-300">{s.code}</pre>}
                  </div>
                </li>
              ))}
            </ol>
            {p.caveat && <p class="mt-6 rounded-xl bg-gray-100 px-4 py-3 text-sm text-gray-600">{p.caveat}</p>}
          </div>
        </div>
      );
    })
  }
</section>

<script>
  import { flutter } from "./flutter.ts";
  document.querySelectorAll<HTMLElement>(".get-started").forEach((root) => {
    const modes = root.querySelectorAll<HTMLElement>("[data-mode]");
    const platforms = root.querySelectorAll<HTMLElement>("[data-platform]");
    const selfPanel = root.querySelector<HTMLElement>('[data-mode-panel="self"]')!;
    const details = root.querySelectorAll<HTMLElement>("[data-detail]");
    const check = (group: NodeListOf<HTMLElement>, picked: HTMLElement) =>
      group.forEach((b) => b.setAttribute("aria-checked", String(b === picked)));
    const show = (key: string) => details.forEach((d) => (d.hidden = d.dataset.detail !== key));
    const selectedPlatform = () => root.querySelector<HTMLElement>('[data-platform][aria-checked="true"]')!.dataset.platform!;

    modes.forEach((m) =>
      m.addEventListener("click", () => {
        check(modes, m);
        const self = m.dataset.mode === "self";
        selfPanel.hidden = !self;
        show(self ? selectedPlatform() : "hosted");
      }),
    );
    platforms.forEach((p) =>
      p.addEventListener("click", () => {
        check(platforms, p);
        show(p.dataset.platform!);
      }),
    );
    root.querySelectorAll<HTMLElement>(".copy-setup").forEach((button) => {
      button.addEventListener("click", async () => {
        flutter(button);
        button.classList.add("copied");
        setTimeout(() => button.classList.remove("copied"), 2000);
        await navigator.clipboard.writeText(button.dataset.prompt!);
      });
    });
  });
</script>
